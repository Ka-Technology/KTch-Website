---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CloseCTA from '../../components/CloseCTA.astro';
import { serviceLabel, img, srcset } from '../../data/site';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((p, i) => ({ params: { slug: p.id }, props: { project: p, next: projects[(i + 1) % projects.length] } }));
}
const { project, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const testimonials = await getCollection('testimonials');
const quote = d.quote_id ? testimonials.find((t) => t.data.id === d.quote_id && t.data.quote.trim())?.data : undefined;
const big = d.cover_image === 'svc-ai' || d.cover_image === 'svc-analytics';
---
<Base title={`${d.client}: ${d.title}`} description={d.summary} og={`work-${project.id}`}>
  <article>
    <header class="wrap hd">
      <h1 class="t-display lines"><span class="line"><span data-line style="--i:0">{d.client}</span></span></h1>
      <div class="grid12 sub">
        <div class="lede" data-load style="--d:300ms">
          <p class="t-lead summary">{d.summary}</p>
          {d.tech.length > 0 && (
            <div class="tech-wrap">
              <h2 class="tech-h">Tech used</h2>
              <ul class="tech">{d.tech.map((t) => <li>{t}</li>)}</ul>
            </div>
          )}
        </div>
        <dl class="facts" data-load style="--d:380ms">
          <div><dt>Project</dt><dd>{d.title}</dd></div>
          <div><dt>Services</dt><dd>{d.services.map((s) => serviceLabel[s]).join(', ')}</dd></div>
          <div><dt>When</dt><dd>{d.year}</dd></div>
          <div><dt>Status</dt><dd>{d.status}</dd></div>
          {d.location && <div><dt>Where</dt><dd>{d.location}</dd></div>}
        </dl>
      </div>
    </header>

    <figure class="photo cover wrap-bleed" data-open>
      <img src={img(d.cover_image, big ? 1600 : 800)} srcset={big ? srcset(d.cover_image) : undefined} sizes="100vw" width="1600" height="900" alt={d.cover_alt} />
    </figure>

    <section class="wrap grid12 block" aria-labelledby="ch">
      <h2 id="ch" class="t-h2 bh">The challenge</h2>
      <p class="t-lead body" data-reveal><span>{d.challenge}</span></p>
    </section>

    <section class="wrap grid12 block" aria-labelledby="built">
      <h2 id="built" class="t-h2 bh">What we built</h2>
      <div class="prose body" data-reveal><Content /></div>
    </section>

    {d.results.length > 0 && (
      <section class="results inverse" aria-labelledby="res">
        <div class="wrap grid12">
          <h2 id="res" class="t-h2 bh">Results</h2>
          <ul class="rl" data-reveal>{d.results.map((r) => <li>{r}</li>)}</ul>
        </div>
      </section>
    )}

    {quote && (
      <section class="wrap grid12 block" aria-label="What the client said">
        <figure class="q body">
          <blockquote>{quote.quote}</blockquote>
          <figcaption><strong>{quote.name}</strong>{quote.title && `, ${quote.title}`}, {quote.company}</figcaption>
        </figure>
      </section>
    )}

    <nav class="wrap nextp" aria-label="Next case study">
      <a href={`/work/${next.id}`}><span class="nl">Next case study</span><span class="nn arrow">{next.data.client}</span></a>
      <p class="allw"><a class="link" href={`/services#${d.services[0]}`}>Back to {serviceLabel[d.services[0]]} services</a></p>
    </nav>
  </article>
  <CloseCTA title={['Have a similar', 'problem?']} />
</Base>

<style>
  .hd { padding-top: clamp(24px, 5vh, 64px); }
  .sub { margin-top: 36px; row-gap: 32px; }
  .lede { grid-column: 1 / 7; display: grid; gap: 28px; align-content: start; }
  .summary { max-width: 36ch; font-weight: 600; }
  .tech-wrap { display: grid; gap: 10px; }
  .tech-h { font-size: var(--t-small); font-weight: 600; letter-spacing: 0; line-height: 1.45; color: var(--muted); }
  .facts { grid-column: 8 / -1; display: grid; grid-template-columns: 1fr 1fr; gap: 18px var(--gap); margin: 0; }
  .facts dt { font-size: var(--t-small); color: var(--muted); font-weight: 600; }
  .facts dd { margin: 2px 0 0; font-weight: 700; }
  .cover { margin-top: clamp(48px, 7vw, 96px); aspect-ratio: 16 / 7; }
  .block { padding-top: var(--section); row-gap: 28px; }
  .bh { grid-column: 1 / 6; }
  .body { grid-column: 6 / -1; max-width: 62ch; }
  .results { margin-top: var(--section); padding-block: clamp(80px, 9vw, 140px); }
  .rl { grid-column: 6 / -1; list-style: none; display: grid; gap: 22px; }
  .rl li { font-size: var(--t-lead); font-weight: 700; letter-spacing: -0.015em; line-height: 1.3; padding-left: 1.1em; position: relative; }
  .rl li::before { content: ""; position: absolute; left: 0; top: 0.5em; width: 0.4em; height: 0.4em; background: var(--accent); }
  .tech { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
  .tech li { background: var(--surface-2); padding: 8px 14px; font-weight: 600; }
  .q blockquote { margin: 0; font-size: var(--t-lead); line-height: 1.35; }
  .q figcaption { margin-top: 16px; }
  .nextp { padding-block: var(--section); }
  .nextp a { display: grid; gap: 8px; text-decoration: none; }
  .nl { font-weight: 600; color: var(--muted); }
  .allw { margin-top: 28px; }
  .nn { font-size: var(--t-h2); font-weight: 800; letter-spacing: -0.04em; line-height: 1; transition: color var(--t-hover) ease; }
  @media (hover: hover) and (pointer: fine) { .nextp a:hover .nn { color: var(--accent-text); } }
  @media (max-width: 860px) {
    .lede, .facts, .bh, .body, .rl { grid-column: 1 / -1; }
    .cover { aspect-ratio: 4 / 3; }
  }
</style>
