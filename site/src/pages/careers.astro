---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { site, img } from '../data/site';
const jobs = await getCollection('jobs', (j) => j.data.open);
const ways = [
  { name: 'Real client work, day one.', text: 'You ship software that real businesses use, not practice projects.' },
  { name: 'Profit sharing.', text: 'Developers share in the profit of the projects they work on.' },
  { name: 'Flexible hours.', text: 'Part-time-friendly involvement that fits around school or another job.' },
];
const process = [
  { name: 'A short case study', text: 'A small, real-world problem to show how you think and build with AI.', pic: 'hire-case', alt: 'Two people working side by side at a café table, one writing in a notebook, one on a laptop.' },
  { name: 'A get-to-know-you chat', text: 'Who you are, what you want to build, and how you like to work.', pic: 'hire-chat', alt: 'A man talking on a video call from his laptop in a bright office.' },
  { name: 'A technical and behavioral interview', text: 'We go deeper on your case study and how you work on a team.', pic: 'hire-interview', alt: 'Two people across a desk in an interview, one listening with a notebook.' },
];
const mail = (subject: string) => `mailto:${site.email}?subject=${encodeURIComponent(subject)}`;
---
<Base og="careers" title="Careers" description="Join Ka Technology: a small, remote-friendly team of AI-native developers shipping real software for real businesses.">
  <PageHead title="Build with us" lede="We’re a small, remote-friendly team that ships real software for real businesses. We look for AI-native developers: people who know how to build with AI and use it well." />

  <!-- How we work: three promises, each led by a large red numeral -->
  <section class="wrap how" aria-labelledby="how-t">
    <h2 id="how-t" class="t-h2">How we work</h2>
    <ol class="nums" data-reveal>
      {ways.map((w, i) => (
        <li><span class="n" aria-hidden="true">{i + 1}</span><div><h3>{w.name}</h3><p>{w.text}</p></div></li>
      ))}
    </ol>
  </section>

  <!-- How we hire: three steps as cards, each with a photo of that moment (grey, colour on hover) -->
  <section class="wrap proc" aria-labelledby="proc-t">
    <h2 id="proc-t" class="t-h2">How we hire</h2>
    <ol class="cards" data-reveal>
      {process.map((p, i) => (
        <li>
          <figure class="photo pic"><img src={img(p.pic, 800)} srcset={`${img(p.pic, 800)} 800w, ${img(p.pic, 1600)} 1600w`} sizes="(max-width: 860px) 100vw, 33vw" width="800" height="450" alt={p.alt} loading="lazy" /></figure>
          <div class="body">
            <p class="k">Step {i + 1} of {process.length}</p>
            <h3>{p.name}</h3>
            <p>{p.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Open roles: the last section before the footer -->
  <section class="roles field" aria-labelledby="roles-t">
    <div class="wrap grid12">
      <h2 id="roles-t" class="t-h2 bh">Open roles</h2>
      <div class="rl" data-reveal>
        {jobs.length > 0 ? (
          <ul>
            {jobs.map((j) => (
              <li>
                <h3>{j.data.title}</h3>
                <p class="jm">{j.data.type} · {j.data.location}</p>
                <p>{j.data.summary}</p>
                <a class="link" href={mail(`Application: ${j.data.title}`)}><span class="arrow">Apply by email</span></a>
              </li>
            ))}
          </ul>
        ) : (
          <div class="none">
            <p class="t-h2 nt">No open roles right now.</p>
            <p class="t-lead note">Send us a note anyway. Tell us what you’ve built and what you’d like to build next. <a class="link go" href={mail('Working with Ka Technology')}><span class="arrow">Email {site.email}</span></a></p>
          </div>
        )}
      </div>
    </div>
  </section>
</Base>

<style>
  .how { padding-bottom: var(--section); }
  .proc { padding-bottom: var(--section); }

  /* How we work · big numerals */
  .nums { list-style: none; margin-top: clamp(36px, 4vw, 64px); display: grid; gap: clamp(28px, 3vw, 44px); }
  .nums li { display: grid; grid-template-columns: clamp(72px, 9vw, 150px) minmax(0, 1fr); gap: var(--gap); align-items: baseline; }
  .n { font-size: clamp(64px, 8vw, 140px); font-weight: 850; letter-spacing: -0.06em; line-height: 0.8; color: var(--accent); }
  .nums h3 { font-size: clamp(26px, 2.6vw, 42px); letter-spacing: -0.04em; line-height: 1.05; }
  .nums p { margin-top: 8px; font-size: var(--t-lead); max-width: 44ch; }

  /* How we hire · photo cards */
  .cards { list-style: none; margin-top: clamp(36px, 4vw, 64px); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); }
  .cards li { background: var(--surface); display: grid; grid-template-rows: auto 1fr; }
  .pic { aspect-ratio: 16 / 10; }
  .pic img { transition: filter 450ms ease; }
  @media (hover: hover) and (pointer: fine) { .cards li:hover .pic img { filter: none; } }
  .body { padding: clamp(22px, 2.4vw, 36px); display: grid; gap: 12px; align-content: start; }
  .k { font-size: var(--t-small); font-weight: 800; color: var(--accent); letter-spacing: 0.02em; }
  .cards h3 { font-size: clamp(24px, 2.2vw, 34px); letter-spacing: -0.04em; line-height: 1.08; }

  /* Open roles */
  .roles { padding-block: clamp(80px, 9vw, 140px); }
  .bh { grid-column: 1 / 6; }
  .rl { grid-column: 6 / -1; }
  .rl ul { list-style: none; display: grid; gap: 40px; }
  .rl h3 { font-size: var(--t-lead); }
  .jm { color: var(--muted); font-weight: 600; margin: 4px 0 10px; }
  .none { display: grid; gap: 20px; justify-items: start; }
  .nt { line-height: 1; }
  .note { max-width: 44ch; }
  .go { white-space: nowrap; font-weight: 750; }

  @media (max-width: 860px) {
    .cards { grid-template-columns: 1fr; }
    .bh, .rl { grid-column: 1 / -1; }
    .rl { margin-top: 28px; }
    .go { white-space: normal; }
  }
</style>
