---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import ClientStrip from '../components/home/ClientStrip.astro';
import BALedger from '../components/home/ba/BALedger.astro';
import PillarTable from '../components/home/PillarTable.astro';
import WorkIndex from '../components/WorkIndex.astro';
import ProductsBand from '../components/ProductsBand.astro';
// TEMPORARY layout options for review: keep one of each set, delete the rest with OptionLabel
import OptionLabel from '../components/home/opt/OptionLabel.astro';
import ProductsGrid from '../components/home/opt/ProductsGrid.astro';
import ProductsRows from '../components/home/opt/ProductsRows.astro';
import ProductsPicker from '../components/home/opt/ProductsPicker.astro';
import HowNumbers from '../components/home/opt/HowNumbers.astro';
import HowStatements from '../components/home/opt/HowStatements.astro';
import HowTrack from '../components/home/opt/HowTrack.astro';
import HowWeWork from '../components/HowWeWork.astro';
import PortlandMosaic from '../components/PortlandMosaic.astro';
import Testimonials from '../components/Testimonials.astro';
import CloseCTA from '../components/CloseCTA.astro';
---
<Base strip={false}>
  <Hero />
  <ClientStrip />
  <BALedger />
  <WorkIndex heading="Featured work" picks={[
    'projects/cida-analytics', 'products/realdoc', 'products/kept', 'products/doigetgas',
    'projects/apex-performance', 'projects/scrubs-and-more', 'projects/hopewell-ranch',
  ]} />
  <PillarTable />
  <OptionLabel n="Products A" name="Lead product + cards (current)" />
  <ProductsBand />
  <OptionLabel n="Products B" name="Equal shelf" />
  <ProductsGrid />
  <OptionLabel n="Products C" name="Catalogue rows" />
  <ProductsRows />
  <OptionLabel n="Products D" name="Picker" />
  <ProductsPicker />
  <OptionLabel n="How A" name="Squares diagram (current)" />
  <HowWeWork />
  <OptionLabel n="How B" name="Big numbers" />
  <HowNumbers />
  <OptionLabel n="How C" name="Statements" />
  <HowStatements />
  <OptionLabel n="How D" name="Track" />
  <HowTrack />
  <PortlandMosaic />
  <Testimonials />
  <CloseCTA />
</Base>
