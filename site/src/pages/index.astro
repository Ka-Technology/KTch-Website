---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import ClientStrip from '../components/home/ClientStrip.astro';
import ChoreSwap from '../components/home/ChoreSwap.astro';
// TEMPORARY before/after options, pick one and delete the rest
import OptionLabel from '../components/home/ba/OptionLabel.astro';
import BALedger from '../components/home/ba/BALedger.astro';
import BAStrike from '../components/home/ba/BAStrike.astro';
import BASwitch from '../components/home/ba/BASwitch.astro';
import BAWipe from '../components/home/ba/BAWipe.astro';
import PillarTable from '../components/home/PillarTable.astro';
import WorkIndex from '../components/WorkIndex.astro';
import ProductsBand from '../components/ProductsBand.astro';
import HowWeWork from '../components/HowWeWork.astro';
import PortlandMosaic from '../components/PortlandMosaic.astro';
import Testimonials from '../components/Testimonials.astro';
import CloseCTA from '../components/CloseCTA.astro';
---
<Base strip={false}>
  <Hero />
  <ClientStrip />
  <OptionLabel n={1} name="Tabs (current)" />
  <ChoreSwap />
  <OptionLabel n={2} name="Ledger" />
  <BALedger />
  <OptionLabel n={3} name="Strike-through" />
  <BAStrike />
  <OptionLabel n={4} name="Switch" />
  <BASwitch />
  <OptionLabel n={5} name="Wipe" />
  <BAWipe />
  <PillarTable />
  <WorkIndex heading="Featured work">
    <p class="all"><a class="button button--ink" href="/work">See all work</a></p>
  </WorkIndex>
  <div class="gap"></div>
  <ProductsBand />
  <HowWeWork />
  <PortlandMosaic />
  <Testimonials />
  <CloseCTA />
</Base>

<style>
  .all { margin-top: 48px; }
  .gap { height: var(--section); }
</style>
