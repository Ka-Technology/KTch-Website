---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import ClientStrip from '../components/home/ClientStrip.astro';
import BALedger from '../components/home/ba/BALedger.astro';
import PillarTable from '../components/home/PillarTable.astro';
import WorkIndex from '../components/WorkIndex.astro';
import ProductsBand from '../components/ProductsBand.astro';
import HowWeWork from '../components/HowWeWork.astro';
import PortlandMosaic from '../components/PortlandMosaic.astro';
import Testimonials from '../components/Testimonials.astro';
import CloseCTA from '../components/CloseCTA.astro';
---
<Base strip={false}>
  <Hero />
  <ClientStrip />
  <BALedger />
  <WorkIndex heading="Featured work" picks={[
    'projects/cida-analytics', 'products/realdoc', 'products/kept', 'products/doigetgas',
    'projects/apex-performance', 'projects/scrubs-and-more', 'projects/hopewell-ranch',
  ]} />
  <PillarTable />
  <ProductsBand />
  <HowWeWork />
  <PortlandMosaic />
  <Testimonials />
  <CloseCTA />
</Base>
