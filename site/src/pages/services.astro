---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CloseCTA from '../components/CloseCTA.astro';
import { getCollection } from 'astro:content';
import { pillars, img, srcset } from '../data/site';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const workFor = (tags: string[]) => projects.filter((p) => p.data.services.some((s) => tags.includes(s)));
// photos that only exist at 800px
const small = ['svc-software', 'svc-automation'];
---
<Base og="services" title="Services" description="AI applications, custom software, process automation and data analytics for small and growing businesses in Portland, Oregon and beyond.">
  <PageHead title="Consulting services" lede="When it comes to AI there’s a lot of buzz. We care about what actually helps your business." />

  <nav class="jump wrap" aria-label="Services on this page">
    <ul>
      {pillars.map((p) => <li><a href={`#${p.slug}`}>{p.name}</a></li>)}
    </ul>
  </nav>

  {pillars.map((p, i) => (
    <section id={p.slug} class={`pillar ${i % 2 ? 'inverse' : ''}`} aria-labelledby={`${p.slug}-t`}>
      <div class="wrap grid12 inner">
        <figure class={`photo pic ${i % 2 ? 'pic--right' : ''}`}>
          <img src={img(p.image, small.includes(p.image) ? 800 : 1600)} srcset={small.includes(p.image) ? undefined : srcset(p.image)}
            sizes="(max-width: 860px) 100vw, 40vw" width="800" height="1100" alt={p.imageAlt} loading="lazy" />
        </figure>
        <div class={`text ${i % 2 ? 'text--left' : ''}`} data-reveal>
          <h2 id={`${p.slug}-t`} class="t-h2">{p.name}</h2>
          <p class="t-lead pitch">{p.pitch}</p>
          <ul class="offers">
            {p.offerings.map((o) => (
              <li>
                <h3>{o.name}</h3>
                <p>{o.text}{o.example && <> Example: <a class="link" href={o.example.href}>{o.example.label}</a>.</>}</p>
              </li>
            ))}
          </ul>
          {(workFor(p.tags ?? [p.slug]).length > 0 || p.partners) && (
            <div class="clients">
              <h3 class="ch">Clients</h3>
              <ul>
                {workFor(p.tags ?? [p.slug]).map((w) => (
                  <li><a href={`/work/${w.id}`}><span class="cn arrow">{w.data.client}</span><span class="cw">{w.data.title}</span></a></li>
                ))}
                {p.partners?.map((c) => <li><div><span class="cn">{c.name}</span><span class="cw">{c.what}</span></div></li>)}
              </ul>
            </div>
          )}
        </div>
      </div>
    </section>
  ))}
  <CloseCTA title={['Not sure which', 'one you need?']} text="Most projects mix two or three of these. Tell us the problem and we’ll suggest the simplest fix." />
</Base>

<style>
  .jump { padding-bottom: clamp(56px, 7vw, 96px); }
  .jump ul { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
  .jump a { display: inline-flex; align-items: center; min-height: 48px; padding: 0 18px; background: var(--surface-2); font-weight: 700; text-decoration: none; transition: background-color var(--t-hover) ease, color var(--t-hover) ease; }
  @media (hover: hover) and (pointer: fine) { .jump a:hover { background: var(--ink); color: var(--bg); } }
  .pillar { padding-block: var(--section); scroll-margin-top: 0; }
  .pillar:not(.inverse) + .pillar:not(.inverse) { padding-top: 0; }
  .inner { row-gap: 48px; align-items: start; }
  .pic { grid-column: 1 / 6; aspect-ratio: 4 / 5; position: sticky; top: 6vh; }
  .pic--right { grid-column: 8 / -1; grid-row: 1; }
  .text { grid-column: 7 / -1; display: grid; gap: 24px; }
  .text--left { grid-column: 1 / 7; grid-row: 1; }
  .pitch { max-width: 34ch; font-weight: 600; }
  .offers { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 32px var(--gap); margin-top: 16px; }
  .offers li { display: grid; gap: 8px; align-content: start; padding-top: 18px; border-top: 0; position: relative; }
  .offers li::before { content: ""; position: absolute; top: 0; left: 0; width: 28px; height: 6px; background: var(--accent); }
  .offers h3 { font-size: var(--t-lead); letter-spacing: -0.02em; line-height: 1.15; }
  .offers p { max-width: 40ch; }
  .clients { margin-top: 16px; display: grid; gap: 12px; }
  .ch { font-size: var(--t-lead); letter-spacing: -0.02em; }
  .clients ul { list-style: none; }
  .clients li > * { display: flex; justify-content: space-between; align-items: baseline; gap: 24px; padding: 14px 16px; margin-inline: -16px; text-decoration: none; }
  .clients li:nth-child(odd) > * { background: var(--surface); }
  .cn { font-weight: 700; }
  .cw { color: var(--muted); text-align: right; }
  .clients a { transition: color var(--t-hover) ease; }
  @media (hover: hover) and (pointer: fine) { .clients a:hover .cn { color: var(--accent-text); } }
  @media (max-width: 860px) {
    .pic, .pic--right, .text, .text--left { grid-column: 1 / -1; grid-row: auto; position: static; }
    .pic { aspect-ratio: 16 / 10; }
    .offers { grid-template-columns: 1fr; }
    .clients li > * { flex-direction: column; gap: 2px; }
    .cw { text-align: left; }
  }
</style>
