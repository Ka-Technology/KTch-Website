---
// TEMPORARY: side-by-side options for the Services jump links. Not committed.
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { pillars, img } from '../data/site';
const last = pillars.length - 1;
---
<Base title="Jump link options" description="Temporary comparison page for the Services jump links." strip={false}>
  <PageHead title="Consulting" lede="When it comes to AI there’s a lot of buzz. We care about what actually helps your business." />

  <p class="wrap tag" id="opt-a">A · Numbered index</p>
  <nav class="wrap a" aria-label="A">
    <ol>{pillars.map((p, i) => <li><a href={`#${p.slug}`}><span class="n">0{i + 1}</span><span class="nm">{p.name}</span><span class="pt">{p.pitch}</span><span class="ar" aria-hidden="true">↓</span></a></li>)}</ol>
  </nav>

  <p class="wrap tag" id="opt-b">B · One sentence</p>
  <nav class="wrap b" aria-label="B">
    <p class="t-lead">We do four things:{' '}
      {pillars.map((p, i) => <><a class="link" href={`#${p.slug}`}>{p.name}</a>{i < last - 1 ? ', ' : i === last - 1 ? ' and ' : '.'}</>)}
    </p>
  </nav>

  <p class="wrap tag" id="opt-c">C · Picture row</p>
  <nav class="wrap c" aria-label="C">
    <ul>{pillars.map((p) => <li><a href={`#${p.slug}`}><figure class="photo"><img src={img(p.image, 800)} width="800" height="450" alt="" /></figure><span class="arrow">{p.name}</span></a></li>)}</ul>
  </nav>

  <p class="wrap tag" id="opt-d">D · Tab bar that follows you down the page</p>
  <nav class="d" aria-label="D">
    <ul class="wrap">{pillars.map((p, i) => <li><a href={`#${p.slug}`} class={i === 0 ? 'on' : ''}>{p.name}</a></li>)}</ul>
  </nav>
  <div style="height: 40px"></div>
</Base>

<style>
  .tag { margin: 56px auto 20px; font-size: var(--t-small); font-weight: 700; color: var(--accent); }
  /* A */
  .a ol { list-style: none; display: grid; }
  .a a { display: grid; grid-template-columns: 56px minmax(0, 1.2fr) minmax(0, 1fr) 32px; align-items: baseline; gap: 24px; padding: 18px 0; text-decoration: none; }
  .a .n { font-weight: 700; color: var(--muted); font-size: var(--t-small); }
  .a .nm { font-size: clamp(24px, 2.4vw, 36px); font-weight: 800; letter-spacing: -0.035em; }
  .a .pt { color: var(--muted); }
  .a .ar { color: var(--accent); font-weight: 700; }
  .a a:hover .nm { color: var(--accent); }
  /* B */
  .b p { font-size: clamp(22px, 2.2vw, 32px); font-weight: 600; line-height: 1.45; max-width: 52ch; letter-spacing: -0.015em; }
  /* C */
  .c ul { list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gap); }
  .c a { display: grid; gap: 12px; text-decoration: none; font-weight: 700; }
  .c figure { aspect-ratio: 16 / 9; }
  .c img { transition: filter 400ms ease; }
  .c a:hover img { filter: none; }
  /* D */
  .d { position: sticky; top: 0; z-index: 5; background: var(--bg); }
  .d ul { list-style: none; display: flex; gap: clamp(20px, 3vw, 44px); }
  .d a { display: inline-flex; align-items: center; min-height: 56px; font-weight: 700; text-decoration: none; color: var(--muted); border-bottom: 3px solid transparent; }
  .d a.on, .d a:hover { color: var(--ink); border-bottom-color: var(--accent); }
</style>
