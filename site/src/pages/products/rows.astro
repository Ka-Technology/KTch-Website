---
// PREVIEW: Our software as a stack of rows. Each row is a strip of the product's world: its clip (grey), its tagline
// set in the product's own typeface and colours, its brand marks and art. Clicking a row opens it in place to show
// the product itself (screenshots) and everything about it. One row open at a time.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import CloseCTA from '../../components/CloseCTA.astro';
import { img } from '../../data/site';
const products = (await getCollection('products', (p) => !p.data.hidden)).sort((a, b) => a.data.order - b.data.order);

type Tile =
  | { k: 'clip'; r: number }
  | { k: 'quote'; r: number; text?: string; by?: string; fs?: number }
  | { k: 'pic'; r: number; src: string; alt: string; fit?: 'cover' | 'contain'; bg?: string; pad?: string; pos?: string }
  | { k: 'word'; r: number; text: string; bg: string; fg: string };
// each product's own type and colours (taken from its code and live site); used only in its tiles.
// Its strip: the clip, its own lines, its marks, and photos of its world (credited on /credits).
const ph = (n: string, r = 1.33): Tile => ({ k: 'pic', r, src: `/images/${n}-800.webp`, alt: '' });
const mark = (src: string, bg: string, pad: string, r = 1): Tile => ({ k: 'pic', r, src, alt: '', fit: 'contain', bg, pad });
const brand: Record<string, { font: string; bg: string; fg: string; fs: number; tiles: Tile[] }> = {
  // Kept: its current icon and mark, people keeping the habits Kept offers, and lines from habitkept.com
  kept: { font: "'Kept Bricolage'", bg: '#F6F4EF', fg: '#1C2143', fs: 1.2, tiles: [
    { k: 'clip', r: 1.25 },
    { k: 'quote', r: 2 },
    ph('pw-kept-h2'),
    { k: 'pic', r: 1, src: '/images/pb-kept-icon-600.webp', alt: '' },
    ph('pw-kept-h5', 1.1),
    ph('pw-kept-h1'),
    { k: 'quote', r: 2.9, text: 'I will read every day for 28 days, or $25 goes to a charity I pick.', fs: 0.72 },
    ph('pw-kept-h6'),
    mark('/images/pb-kept-mark.webp', '#F6F4EF', '18%'),
    ph('pw-kept-h4'),
    ph('pw-kept-h3'),
    { k: 'quote', r: 2.1, text: 'Be first to keep your word.' },
    ph('pw-kept-h0'),
    ph('pw-kept-h8'),
    ph('pw-kept-h7', 1.1),
  ] },
  // DoIGetGas: lines and this week's price from doigetgas.com
  doigetgas: { font: "'Gas Space Grotesk'", bg: '#0F0A08', fg: '#F3ECE4', fs: 1, tiles: [
    { k: 'quote', r: 1.8 },
    ph('pw-gas-0'),
    { k: 'clip', r: 1.25 },
    { k: 'quote', r: 1.8, text: 'Pump prices lag crude.' },
    ph('pw-gas-4', 1.6),
    mark('/images/pb-gas-icon.svg', '#0F0A08', '24%'),
    ph('pw-gas-2', 1.6),
    { k: 'quote', r: 2, text: 'Regular gas is $3.81 a gallon.', by: 'U.S. average, week of Nov 16 · EIA' },
    ph('pw-gas-1'),
    ph('pw-gas-5'),
    { k: 'quote', r: 2.4, text: 'Crude oil is the biggest input to the cost of gasoline.', fs: 0.8 },
    ph('pw-gas-3'),
  ] },
  // RealDoc: its wordmark, round mark and pen, classrooms and houses, and Tammy Sue's words from realdoc.app
  realdoc: { font: "'RealDoc Geist'", bg: '#0A4A74', fg: '#FFFFFF', fs: 0.8, tiles: [
    mark('/images/pb-realdoc-word-800.webp', '#E9EFF5', '10%', 1.5),
    ph('pw-rd-c0', 0.9),
    { k: 'clip', r: 1.25 },
    { k: 'quote', r: 2.2 },
    ph('pw-rd-0'),
    mark('/images/pb-realdoc-mark.webp', '#E9EFF5', '20%'),
    ph('pw-rd-c1'),
    { k: 'quote', r: 3.2, text: '“This app has saved me so many hours! The developers made it very easy to use and implement. I’m thrilled to have this resource!”', by: 'Tammy Sue Schuck, Principal Broker, Keller Williams Eugene-Springfield', fs: 0.72 },
    ph('pw-rd-2', 0.8),
    ph('pw-rd-c3'),
    mark('/images/pb-realdoc-pen.webp', '#E9EFF5', '16%', 0.9),
    ph('pw-rd-c4'),
    ph('pw-rd-3'),
    ph('pw-rd-c2'),
  ] },
  // Shiftwize: its bolt and wordmark, cafés and kitchens, and its own lines
  shiftwize: { font: "'Shiftwize Jakarta'", bg: '#00AFFE', fg: '#04121F', fs: 1, tiles: [
    { k: 'clip', r: 1.25 },
    ph('pw-sw-2'),
    { k: 'quote', r: 1.9 },
    mark('/images/pb-shiftwize-bolt.svg', '#E3F5FE', '22%'),
    ph('pw-sw-0'),
    { k: 'quote', r: 1.8, text: 'Set your availability.' },
    { k: 'word', r: 1.3, text: 'SHIFTWIZE', bg: '#E3F5FE', fg: '#1A9FE8' },
    ph('pw-sw-5', 1),
    { k: 'quote', r: 1.9, text: 'Hard rules it never breaks.' },
    ph('pw-sw-3'),
  ] },
};
// every name is set at the size that fits the longest one
const nameLen = Math.max(...products.map((p, i) => `${i + 1}. ${p.data.name}`.length));
const sumR = (id: string) => brand[id].tiles.reduce((t, x) => t + x.r, 0);
const isPhone = (id: string) => id === 'kept';
const shots: Record<string, { w: number[]; alt: string }> = {
  kept: { w: [400, 800], alt: 'The Kept app’s Challenges screen, with free habit trackers for reading and working out.' },
  doigetgas: { w: [800, 1600], alt: 'DoIGetGas showing its gas-price gauge pointing to “Might fall”, above this week’s U.S. average prices.' },
  realdoc: { w: [800, 1600], alt: 'RealDoc’s certificate form: course details, a CSV upload and a signature picker.' },
  shiftwize: { w: [800, 1073], alt: 'Shiftwize’s availability planner: a week grid of preferred and available hours.' },
};
// a second picture of the product itself, shown beside the main screen when the row is open
const extra: Record<string, { src: string; alt: string }> = {
  realdoc: { src: '/images/pb-realdoc-qr-1600.webp', alt: 'RealDoc’s QR-code page beside the sign-in form it opens for a class.' },
  shiftwize: { src: '/images/pb-shiftwize-prefs-800.webp', alt: 'Shiftwize’s scheduling preferences and team context, such as a critical gap on Friday.' },
};
const shotSrc = (id: string) => `/images/shot-${id}-${shots[id].w[1]}.webp`;
const shotSet = (id: string) => shots[id].w.map((w) => `/images/shot-${id}-${w}.webp ${w}w`).join(', ');
const host = (u: string) => u.replace(/^https?:\/\//, '').replace(/\/$/, '');
const split = (t: string) => { const m = t.match(/^(.+?[.!?])\s+(.*)$/s); return m ? [m[1], m[2]] : [t, '']; };
---
<Base og="products" title="Our software" description="Kept, DoIGetGas, RealDoc and Shiftwize: software Ka Technology builds and runs itself.">
  <PageHead title="Our software" lede="Besides client work, we build our own products. Some started as a client’s problem that turned out to be everyone’s problem." />

  <section class="rows" aria-label="Our products" data-rows>
    {products.map((p, i) => {
      const d = p.data; const b = brand[p.id];
      const [lead, more] = split(d.problem);
      return (
        <article class="prod" id={p.id} data-prod style={`--bf:${b.font};--bb:${b.bg};--bc:${b.fg};--bs:${b.fs}`}>
          <div class="row" data-row>
            <h2 class="name" style={`--len:${nameLen}`}>
              <button type="button" class="open" aria-expanded="false" aria-controls={`more-${p.id}`} data-open>
                <span class="nm">{i + 1}. {d.name}</span>
                <span class="plus" aria-hidden="true"></span>
                <span class="sr">, show details</span>
              </button>
            </h2>
            <div class="strip" data-strip aria-hidden="true" style={`--dur:${Math.round(sumR(p.id) * 6.5)}s`}>
              <div class={`track ${i % 2 ? 'is-rev' : ''}`}>
                {[0, 1].map(() => (
                  <div class="set">
                  {b.tiles.map((t) => (
                    <div class={`tile t-${t.k}`} style={`--r:${t.r}${t.k === 'pic' && t.bg ? `;background:${t.bg}` : ''}${t.k === 'word' ? `;background:${t.bg};color:${t.fg}` : ''}`}>
                      {t.k === 'clip' && <video muted loop playsinline preload="none" poster={img(`prod-${p.id}-poster`, 800)}><source src={`/video/prod-${p.id}.mp4`} type="video/mp4" /></video>}
                      {t.k === 'quote' && <p style={t.fs ? `--qs:${t.fs}` : undefined}>{t.text ?? d.tagline}{t.by && <span class="by">{t.by}</span>}</p>}
                      {t.k === 'pic' && <img src={t.src} alt="" loading="lazy" style={`object-fit:${t.fit ?? 'cover'}${t.pad ? `;padding:${t.pad}` : ''}${t.pos ? `;object-position:${t.pos}` : ''}`} />}
                      {t.k === 'word' && <span>{t.text}</span>}
                    </div>
                  ))}
                  </div>
                ))}
              </div>
            </div>
          </div>

          <div class="more" id={`more-${p.id}`} data-more>
            <div class="more-in">
              <div class="wrap grid12 body">
                <div class="pics">
                  <div class={`shot ${isPhone(p.id) ? 'is-phone' : ''}`}>
                    {!isPhone(p.id) && <div class="bar"><span>{d.url ? host(d.url) : `${d.name.toLowerCase()}.app`}</span></div>}
                    <img src={shotSrc(p.id)} srcset={shotSet(p.id)} sizes="(max-width: 860px) 90vw, 55vw" alt={shots[p.id].alt} loading="lazy" />
                  </div>
                  {extra[p.id] && <img class="extra" src={extra[p.id].src} alt={extra[p.id].alt} loading="lazy" />}
                </div>
                <div class="facts">
                  <p class="meta">{d.status}, since {d.year}</p>
                  <div class="blk">
                    <h3 class="k">The problem</h3>
                    <p class="lead">{lead}</p>
                    {more && <p class="dim">{more}</p>}
                  </div>
                  <div class="blk">
                    <h3 class="k">What we built</h3>
                    <p>{d.summary}</p>
                  </div>
                  {d.how_it_works.length > 0 && (
                    <div class="blk">
                      <h3 class="k">How it works</h3>
                      <ol class="how">{d.how_it_works.map((s) => <li>{s}</li>)}</ol>
                    </div>
                  )}
                  {d.features.length > 0 && (
                    <div class="blk">
                      <h3 class="k">The details</h3>
                      <ul class="feats">{d.features.map((f) => <li>{f}</li>)}</ul>
                    </div>
                  )}
                  {d.tech.length > 0 && <p class="tech">Built with {d.tech.join(', ')}.</p>}
                  {d.url && <a class="button visit" href={d.url} rel="noopener">Visit {host(d.url)}</a>}
                </div>
              </div>
            </div>
          </div>
        </article>
      );
    })}
  </section>

  <CloseCTA title={['Your problem might be', 'everyone’s, too.']} text="Some of our products started as one client’s request. If yours sounds familiar, let’s talk." />
</Base>

<script>
  // Rows open in place, one at a time; the whole row is clickable (the name is the real button). Clips play only
  // while their row is on screen. A link to /products/#id opens that product.
  const root = document.querySelector<HTMLElement>('[data-rows]');
  if (root) {
    const prods = [...root.querySelectorAll<HTMLElement>('[data-prod]')];
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const set = (el: HTMLElement, open: boolean) => {
      el.classList.toggle('is-open', open);
      el.querySelector('[data-open]')!.setAttribute('aria-expanded', String(open));
      el.querySelector<HTMLElement>('[data-more]')!.inert = !open;
    };
    root.classList.add('is-live');
    prods.forEach((el) => set(el, false));
    const toggle = (el: HTMLElement, scroll = false) => {
      const opening = !el.classList.contains('is-open');
      prods.forEach((o) => o !== el && o.classList.contains('is-open') && set(o, false));
      set(el, opening);
      if (opening) history.replaceState(null, '', `#${el.id}`);
      if (opening && scroll) el.scrollIntoView({ behavior: still ? 'auto' : 'smooth', block: 'start' });
    };
    prods.forEach((el) => {
      const btn = el.querySelector<HTMLButtonElement>('[data-open]')!;
      btn.addEventListener('click', (e) => { e.stopPropagation(); toggle(el); });
      el.querySelector('[data-row]')!.addEventListener('click', () => toggle(el));
    });
    // The strips drift on their own, alternate rows the other way. Each can be grabbed and dragged either way
    // (a flick keeps gliding briefly); a drag never opens the row, only a plain click does.
    root.querySelectorAll<HTMLElement>('[data-strip]').forEach((strip, i) => {
      const track = strip.querySelector<HTMLElement>('.track')!;
      const first = track.querySelector<HTMLElement>('.set')!;
      const dir = i % 2 ? -1 : 1;
      let width = first.getBoundingClientRect().width, offset = dir < 0 ? width / 2 : 0;
      let down = false, moved = false, startX = 0, lastX = 0, lastT = 0, vel = 0, prev = performance.now();
      const speed = () => width / parseFloat(getComputedStyle(strip).getPropertyValue('--dur'));
      const place = () => { offset = ((offset % width) + width) % width; track.style.transform = `translateX(${-offset}px)`; };
      const tick = (t: number) => {
        const dt = Math.min(64, t - prev) / 1000; prev = t;
        if (!down) {
          if (Math.abs(vel) > 5) { offset += vel * dt; vel *= Math.pow(0.04, dt); }
          else { vel = 0; if (!still) offset += dir * speed() * dt; }
        }
        place(); requestAnimationFrame(tick);
      };
      strip.addEventListener('pointerdown', (e) => {
        if (e.button !== 0) return;
        down = true; moved = false; vel = 0; startX = lastX = e.clientX; lastT = performance.now();
      });
      strip.addEventListener('pointermove', (e) => {
        if (!down) return;
        if (!moved && Math.abs(e.clientX - startX) > 6) { moved = true; strip.setPointerCapture(e.pointerId); strip.classList.add('is-dragging'); }
        if (!moved) return;
        const now = performance.now(), dx = e.clientX - lastX;
        offset -= dx; vel = (-dx / Math.max(1, now - lastT)) * 1000; lastX = e.clientX; lastT = now;
      });
      const end = (e: PointerEvent) => {
        if (!down) return;
        down = false; strip.classList.remove('is-dragging');
        if (performance.now() - lastT > 80) vel = 0;
        if (strip.hasPointerCapture(e.pointerId)) strip.releasePointerCapture(e.pointerId);
      };
      strip.addEventListener('pointerup', end);
      strip.addEventListener('pointercancel', end);
      // the click that ends a drag is swallowed here, before it reaches the row
      strip.addEventListener('click', (e) => { if (moved) { e.stopPropagation(); moved = false; } }, true);
      strip.addEventListener('dragstart', (e) => e.preventDefault());
      addEventListener('resize', () => { width = first.getBoundingClientRect().width; });
      strip.classList.add('is-live');
      requestAnimationFrame(tick);
    });
    const fromHash = () => { const t = prods.find((el) => `#${el.id}` === location.hash); if (t && !t.classList.contains('is-open')) toggle(t, true); };
    fromHash(); addEventListener('hashchange', fromHash);
    if (!still) {
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) { if (v.preload !== 'auto') { v.preload = 'auto'; v.load(); } v.play().catch(() => {}); } else v.pause();
      }), { rootMargin: '0px 0px -10% 0px' });
      root.querySelectorAll('video').forEach((v) => io.observe(v));
    }
  }
</script>

<style>
  /* each product's own typeface, used only inside its own tiles */
  @font-face { font-family: 'Kept Bricolage'; src: url('/fonts/kept-bricolage-800.woff2') format('woff2'); font-weight: 800; font-display: swap; }
  @font-face { font-family: 'Gas Space Grotesk'; src: url('/fonts/gas-spacegrotesk-700.woff2') format('woff2'); font-weight: 800; font-display: swap; }
  @font-face { font-family: 'RealDoc Geist'; src: url('/fonts/realdoc-geist-700.woff2') format('woff2'); font-weight: 800; font-display: swap; }
  @font-face { font-family: 'Shiftwize Jakarta'; src: url('/fonts/shiftwize-jakarta-800.woff2') format('woff2'); font-weight: 800; font-display: swap; }
  @font-face { font-family: 'Shiftwize Jakarta'; src: url('/fonts/shiftwize-jakarta-800i.woff2') format('woff2'); font-weight: 800; font-style: italic; font-display: swap; }

  .rows { --H: clamp(190px, 18vw, 300px); display: grid; gap: clamp(14px, 1.4vw, 22px); padding-bottom: clamp(8px, 1vw, 16px); }

  /* a row: the product's name on its side, then its strip running to the right edge */
  .row { display: grid; grid-template-columns: calc(var(--margin) + clamp(56px, 5.4vw, 92px)) minmax(0, 1fr); height: var(--H); }
  .name { position: relative; height: var(--H); }
  /* the name reads up from the row's bottom edge, with its plus right on top of it, so the two read as one control */
  .open { all: unset; box-sizing: border-box; cursor: pointer; position: absolute; inset: 0; display: flex; flex-direction: column-reverse; align-items: center; justify-content: flex-start; gap: 14px;
    padding: 0 0 0 var(--margin); }
  .nm { writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; font-weight: 800; letter-spacing: -0.04em; line-height: 1; transition: color 200ms ease;
    font-size: min(clamp(34px, 3.8vw, 64px), calc((var(--H) - 52px) / (var(--len) * 0.56))); }
  .plus { position: relative; flex: none; width: 30px; height: 30px; border-radius: 50%; background: var(--ink); transition: transform 350ms var(--ease-out), background-color 200ms ease; }
  .plus::before, .plus::after { content: ""; position: absolute; left: 50%; top: 50%; width: 12px; height: 2px; background: var(--bg); transform: translate(-50%, -50%); }
  .plus::after { transform: translate(-50%, -50%) rotate(90deg); }
  .open:focus-visible .plus { outline: 2px solid var(--accent); outline-offset: 3px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* the strip drifts sideways for ever (two copies of the tiles make the loop seamless); rows alternate direction */
  .strip { height: 100%; min-width: 0; overflow: hidden; cursor: pointer; }
  /* once the script runs: grab to drag; vertical swipes still scroll the page */
  .strip.is-live { cursor: grab; touch-action: pan-y; user-select: none; -webkit-user-select: none; }
  .strip.is-dragging { cursor: grabbing; }
  .strip img { -webkit-user-drag: none; }
  .track { will-change: transform; }
  .track { display: flex; width: max-content; height: 100%; }
  .set { display: flex; gap: 6px; padding-right: 6px; height: 100%; }
  @media (prefers-reduced-motion: no-preference) {
    .strip:not(.is-live) .track { animation: drift var(--dur) linear infinite; }
    .track.is-rev { animation-direction: reverse; }
  }
  @keyframes drift { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .tile { position: relative; flex: none; width: calc(var(--H) * var(--r)); height: 100%; overflow: hidden; background: var(--surface); container-type: size;
    filter: grayscale(1) contrast(1.05); transition: filter 700ms ease; }
  /* everything in grey until the row is opened; then the product's own colours come back */
  .is-open .tile { filter: none; }
  .tile img, .tile video { display: block; width: 100%; height: 100%; object-fit: cover; box-sizing: border-box; transition: transform 600ms var(--ease-out); }
  .t-quote { background: var(--bb); color: var(--bc); display: grid; place-items: center; padding: 0 clamp(18px, 2.2vw, 36px); }
  .t-quote p { width: 100%; font-family: var(--bf), var(--font); font-weight: 800; line-height: 1.02; letter-spacing: -0.03em; text-wrap: balance; text-align: center;
    font-size: calc(var(--H) * 0.16 * var(--bs) * var(--qs, 1)); }
  .t-quote .by { display: block; margin-top: 0.9em; font-family: var(--font); font-size: max(12px, 0.34em); font-weight: 650; letter-spacing: 0; line-height: 1.3; opacity: 0.8; }
  .t-word { display: grid; place-items: center; }
  .t-word span { font-family: 'Shiftwize Jakarta', var(--font); font-style: italic; font-weight: 800; letter-spacing: -0.02em; font-size: 13cqw; }

  /* a row you can open: on hover the plus turns red and the pictures lean in a touch */
  @media (hover: hover) and (pointer: fine) {
    .row:hover .plus { background: var(--accent); }
    .row:hover .nm { color: var(--accent); }
    .row:hover .tile img, .row:hover .tile video { transform: scale(1.03); }
  }
  .is-open .plus { background: var(--accent); transform: rotate(45deg); }
  .is-open .nm { color: var(--accent); }

  /* the opened row: the product's screens on the left, everything about it on the right */
  .rows.is-live .more { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 520ms var(--ease-out); }
  .rows.is-live .is-open .more { grid-template-rows: 1fr; }
  .more-in { overflow: hidden; min-height: 0; }
  .body { padding-block: clamp(40px, 5vw, 72px) clamp(56px, 7vw, 104px); row-gap: 40px; }
  .rows.is-live .body { opacity: 0; transition: opacity 300ms ease; }
  .rows.is-live .is-open .body { opacity: 1; transition-delay: 150ms; }
  .pics { grid-column: 1 / 8; display: grid; gap: 6px; align-content: start; }
  .facts { grid-column: 8 / -1; display: grid; gap: 26px; align-content: start; justify-items: start; }
  .shot { width: 100%; background: #fafaf9; display: grid; grid-template-rows: auto 1fr; overflow: hidden; }
  .shot img { width: 100%; display: block; }
  .shot.is-phone { width: min(300px, 70%); grid-template-rows: 1fr; border: 7px solid #0b0b0c; border-radius: 30px; justify-self: center; }
  .bar { height: 28px; display: flex; align-items: center; padding: 0 12px; background: var(--surface-2); font-size: 11px; font-weight: 600; color: var(--muted); }
  .extra { width: 100%; display: block; }
  .shot.is-phone + .extra { margin-top: 18px; }
  .meta { font-weight: 700; font-size: var(--t-small); color: var(--muted); }
  .blk { display: grid; gap: 10px; max-width: 56ch; }
  .k { font-size: var(--t-small); font-weight: 800; }
  .lead { font-size: var(--t-lead); font-weight: 650; line-height: 1.35; }
  .dim, .tech { color: var(--muted); }
  .tech { font-size: var(--t-small); max-width: 56ch; }
  .how { list-style: none; counter-reset: s; display: grid; gap: 8px; }
  .how li { counter-increment: s; display: grid; grid-template-columns: 1.6em 1fr; }
  .how li::before { content: counter(s); font-weight: 800; }
  .feats { list-style: none; display: grid; gap: 8px; }
  .feats li { padding-left: 1.1em; position: relative; }
  .feats li::before { content: ""; position: absolute; left: 0; top: 0.62em; width: 0.4em; height: 0.4em; background: var(--ink); }

  @media (max-width: 860px) {
    .rows { --H: 180px; gap: 28px; }
