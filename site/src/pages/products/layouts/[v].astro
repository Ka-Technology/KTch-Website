        const g = ease(clamp(p / 0.4));
        sec.style.setProperty('--ki', `${(1 - g) * 18}%`); sec.style.setProperty('--kx', `${(1 - g) * 22}%`);
        sec.style.setProperty('--kd', String(clamp((p - 0.35) / 0.3)));
        sec.style.setProperty('--kt', String(ease(clamp((p - 0.4) / 0.2))));
        sec.style.setProperty('--ks', String(ease(clamp((p - 0.65) / 0.25))));
      });
    };
    let ticking = false;
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(() => { upd(); ticking = false; }); } }, { passive: true });
    addEventListener('resize', upd); upd();
  }
  // L: the story in the middle of the screen picks the clip on the left
  const lw = document.querySelector<HTMLElement>('[data-l]');
  if (lw) {
    const layers = [...lw.querySelectorAll<HTMLElement>('[data-ll]')];
    const io4 = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { const i = (e.target as HTMLElement).dataset.ls; layers.forEach((l) => l.classList.toggle('is-on', l.dataset.ll === i)); } }), { rootMargin: '-45% 0px -45% 0px' });
    lw.querySelectorAll('[data-ls]').forEach((s) => io4.observe(s));
  }
</script>
