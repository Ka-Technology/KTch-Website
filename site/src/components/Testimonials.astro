---
import { getCollection } from 'astro:content';
// Only approved, verbatim quotes render. Empty quotes are hidden, so nothing fake ships.
const items = (await getCollection('testimonials')).map((t) => t.data).filter((t) => t.quote.trim());
---
{items.length > 0 && (
  <section class="quotes section" aria-labelledby="quotes-title">
    <div class="wrap"><h2 id="quotes-title" class="t-h2">In their words</h2></div>
    <div class="track" tabindex="0" aria-label="Testimonials">
      {items.map((t) => (
        <figure class="q">
          {t.photo && <img src={t.photo} width="96" height="96" alt={`Portrait of ${t.name}`} loading="lazy" class="who-pic" />}
          <blockquote>{t.quote}</blockquote>
          <figcaption><strong>{t.name}</strong>{t.title && `, ${t.title}`}<br />{t.company}</figcaption>
        </figure>
      ))}
    </div>
  </section>
)}

<style>
  .track { margin-top: 48px; display: flex; gap: var(--gap); overflow-x: auto; scroll-snap-type: x mandatory; padding: 0 var(--margin) 16px; }
  .q { flex: 0 0 min(560px, 86vw); scroll-snap-align: start; margin: 0; background: var(--surface); padding: 36px; display: grid; gap: 24px; align-content: start; }
  .who-pic { width: 72px; height: 72px; object-fit: cover; border-radius: 50%; filter: var(--photo-filter); }
  blockquote { margin: 0; font-size: var(--t-lead); line-height: 1.3; letter-spacing: -0.015em; }
  figcaption { font-size: var(--t-small); }
</style>
