---
import { pillars } from '../../data/site';
import PillarDialogs from './PillarDialogs.astro';
---
<section class="pillars wrap section" aria-labelledby="pillars-title">
  <div class="head" data-reveal>
    <h2 id="pillars-title" class="t-h2">What we do</h2>
    <p class="t-lead measure">Four kinds of work, one goal: fewer tedious hours. Open any row for the details.</p>
  </div>

  <div class="table" role="table" aria-label="Our four services">
    <div class="feature-bg" aria-hidden="true" style={`--rows:${pillars.length + 1}`}></div>
    <div class="tr th" role="row" style="--r:1">
      <span role="columnheader">Service</span>
      <span role="columnheader">What it’s for</span>
      <span role="columnheader">What we build</span>
      <span role="columnheader" class="fc">Proof</span>
    </div>
    {pillars.map((_, i) => i % 2 === 1 && <div class="band" aria-hidden="true" style={`--r:${i + 2}`}></div>)}
    {pillars.map((p, i) => (
      <div class={`tr ${i % 2 ? 'odd' : ''}`} role="row" style={`--r:${i + 2}`}>
        <span role="rowheader" class="name">
          <button type="button" data-open-dialog={`dlg-${p.slug}`} aria-haspopup="dialog">{p.name}</button>
        </span>
        <span role="cell" class="pitch">{p.pitch}</span>
        <span role="cell" class="build">{p.offerings.map((o) => o.name).join(', ')}.</span>
        <span role="cell" class="fc proof">{p.caseStudy && <a href={p.caseStudy.href}><span class="arrow">{p.caseStudy.label}</span></a>}</span>
      </div>
    ))}
  </div>

  <PillarDialogs />
</section>


<style>
  .head { display: grid; gap: 20px; margin-bottom: 48px; }
  .table { position: relative; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); }
  .feature-bg { grid-column: 10 / -1; grid-row: 1 / span var(--rows); margin-top: -24px; background: var(--ink); z-index: 0; }
  .tr { display: contents; }
  .tr > * { grid-row: var(--r); padding: 22px 0; position: relative; z-index: 1; }
  .tr > :nth-child(1) { grid-column: 1 / 4; }
  .tr > :nth-child(2) { grid-column: 4 / 7; }
  .tr > :nth-child(3) { grid-column: 7 / 10; }
  .tr > :nth-child(4) { grid-column: 10 / -1; padding-inline: 20px; }
  .th > * { font-size: var(--t-body); font-weight: 700; padding-top: 0; }
  .fc { color: var(--bg); background: var(--ink); }
  .th .fc { color: var(--bg); background: var(--ink); }
  /* every other row a tone darker, across the non-featured columns */
  .band { grid-column: 1 / 10; grid-row: var(--r); background: var(--surface); margin-left: calc(var(--margin) * -1); margin-right: calc(var(--gap) * -1); }
  .name button {
    all: unset; cursor: pointer; font-size: var(--t-lead); font-weight: 800; letter-spacing: -0.03em; line-height: 1.1;
    text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 3px; text-underline-offset: 6px;
    transition: text-decoration-color var(--t-hover) ease, color var(--t-hover) ease;
  }
  .name button:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
  @media (hover: hover) and (pointer: fine) { .name button:hover { text-decoration-color: var(--accent); } }
  .name button::after { content: " +"; color: var(--accent-text); }
  .pitch, .build { font-size: var(--t-body); line-height: 1.45; padding-right: 12px; }
  .proof a { color: var(--bg); font-weight: 700; font-size: var(--t-body); text-decoration: none; }
  @media (hover: hover) and (pointer: fine) { .proof a:hover { color: var(--accent); } }


  @media (max-width: 860px) {
    .table { grid-template-columns: minmax(0, 1fr); }
    .feature-bg, .band, .th { display: none; }
    .tr > * { grid-column: 1 / -1 !important; grid-row: auto !important; padding: 0 !important; }
    .tr > .name { padding-top: 40px !important; padding-bottom: 10px !important; }
    .tr > .pitch { padding-bottom: 8px !important; }
    .tr > .build { color: var(--muted); padding-bottom: 14px !important; }
    .tr > .fc { padding: 14px 16px !important; }
  }
</style>
