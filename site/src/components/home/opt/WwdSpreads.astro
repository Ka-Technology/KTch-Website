---
// What we do, A: one spread per service, photo and words alternating sides.
import { pillars, img } from '../../../data/site';
---
<section class="wrap section" aria-labelledby="wwd-a">
  <div class="head" data-reveal>
    <h2 id="wwd-a" class="t-h2">What we do</h2>
    <p class="t-lead">Four kinds of work, one goal: fewer tedious hours.</p>
  </div>
  <div class="list">
    {pillars.map((p, i) => (
      <article class={`row grid12 ${i % 2 ? 'flip' : ''}`} data-reveal>
        <figure class="photo pic"><img src={img(p.image, 1600)} width="1600" height="1200" alt={p.imageAlt} loading="lazy" /></figure>
        <div class="txt">
          <h3>{p.name}</h3>
          <p class="t-lead">{p.pitch}</p>
          <p class="build">{p.offerings.map((o) => o.name).join(' · ')}</p>
          <div class="acts">
            <button type="button" class="button" data-open-dialog={`dlg-${p.slug}`} aria-haspopup="dialog">What’s included</button>
            {p.caseStudy && <a class="link" href={p.caseStudy.href}><span class="arrow">See {p.caseStudy.label}</span></a>}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .head { display: grid; gap: 20px; margin-bottom: clamp(48px, 6vw, 88px); }
  .list { display: grid; gap: clamp(64px, 8vw, 128px); }
  .row { align-items: center; }
  .pic { grid-column: 1 / 7; aspect-ratio: 4 / 3; }
  .txt { grid-column: 8 / -1; display: grid; gap: 20px; }
  .flip .pic { grid-column: 7 / -1; grid-row: 1; }
  .flip .txt { grid-column: 1 / 6; grid-row: 1; }
  h3 { font-size: clamp(34px, 3.6vw, 60px); font-weight: 850; letter-spacing: -0.045em; line-height: 1; }
  .build { color: var(--muted); max-width: 44ch; }
  .acts { display: flex; flex-wrap: wrap; gap: 20px; align-items: center; margin-top: 8px; }
  .acts .link { font-weight: 700; }
  @media (max-width: 860px) {
    .pic, .txt, .flip .pic, .flip .txt { grid-column: 1 / -1; grid-row: auto; }
    .txt { margin-top: 24px; }
  }
</style>
