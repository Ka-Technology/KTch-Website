---
// How option B, Big numbers: three columns, each led by a huge red numeral.
const steps = [
  { name: 'Listen.', text: 'We start with your problem, not our favorite tech.' },
  { name: 'Build.', text: 'Small team, fast iterations, regular demos.' },
  { name: 'Stick around.', text: 'We maintain and improve what we ship.' },
];
---
<section class="hn wrap section" aria-labelledby="hn-t">
  <div class="grid12 top" data-reveal>
    <h2 id="hn-t" class="t-h2 heading">How we work</h2>
    <p class="t-lead para">Your messy, scattered process goes in. One clear tool comes out, and we keep it running.</p>
  </div>
  <ol class="steps" data-reveal>
    {steps.map((s, i) => (
      <li>
        <span class="num" aria-hidden="true">{i + 1}</span>
        <h3>{s.name}</h3>
        <p>{s.text}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .heading { grid-column: 1 / 6; }
  .para { grid-column: 7 / -1; max-width: 40ch; }
  .steps { list-style: none; margin-top: clamp(48px, 6vw, 88px); display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap); }
  .steps li { display: grid; gap: 14px; align-content: start; background: var(--surface); padding: clamp(24px, 2.6vw, 40px); }
  .num { font-size: clamp(110px, 13vw, 220px); font-weight: 850; letter-spacing: -0.06em; line-height: 0.8; color: var(--accent); }
  .steps h3 { font-size: var(--t-h2); letter-spacing: -0.04em; margin-top: 18px; }
  .steps p { max-width: 28ch; }
  @media (max-width: 860px) {
    .heading, .para { grid-column: 1 / -1; }
    .para { margin-top: 20px; }
    .steps { grid-template-columns: 1fr; }
    .steps li { grid-template-columns: auto 1fr; column-gap: 20px; }
    .num { grid-row: span 2; font-size: 96px; }
    .steps h3 { margin-top: 0; align-self: end; }
  }
</style>
