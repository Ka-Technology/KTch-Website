---
// What we do, B: a 2 by 2 of big photo tiles, the name set on a black block at the foot of each.
import { pillars, img } from '../../../data/site';
---
<section class="wrap section" aria-labelledby="wwd-b">
  <div class="head grid12" data-reveal>
    <h2 id="wwd-b" class="t-h2">What we do</h2>
    <p class="t-lead">Four kinds of work, one goal: fewer tedious hours. Open any one for the details.</p>
  </div>
  <div class="tiles">
    {pillars.map((p) => (
      <article class="tile" data-reveal>
        <button type="button" class="hit" data-open-dialog={`dlg-${p.slug}`} aria-haspopup="dialog">
          <figure class="photo pic"><img src={img(p.image, 1600)} width="1600" height="1100" alt="" loading="lazy" /></figure>
          <span class="name">{p.name}<span class="plus" aria-hidden="true">+</span></span>
        </button>
        <div class="below">
          <p>{p.pitch}</p>
          {p.caseStudy && <a class="link" href={p.caseStudy.href}><span class="arrow">{p.caseStudy.label}</span></a>}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .head { margin-bottom: clamp(40px, 5vw, 72px); row-gap: 20px; }
  .head h2 { grid-column: 1 / 6; }
  .head p { grid-column: 7 / -1; max-width: 40ch; }
  .tiles { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 4vw, 64px) var(--gap); }
  .tile > * { min-width: 0; }
  .hit { all: unset; display: block; position: relative; cursor: pointer; width: 100%; }
  .hit:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
  .pic { aspect-ratio: 16 / 11; }
  .pic img { transition: transform 900ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .hit:hover .pic img { transform: scale(1.03); } .hit:hover .plus { transform: rotate(90deg); } }
  .name {
    position: absolute; left: 0; bottom: 0; max-width: calc(100% - 48px);
    display: flex; gap: 18px; align-items: baseline;
    background: var(--ink); color: var(--bg); padding: 18px 24px 20px;
    font-size: clamp(24px, 2.4vw, 40px); font-weight: 850; letter-spacing: -0.04em; line-height: 1.05;
  }
  .plus { color: var(--accent); display: inline-block; transition: transform var(--t-hover) var(--ease-out); }
  .below { display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: baseline; margin-top: 18px; }
  .below p { max-width: 40ch; }
  .below .link { font-weight: 700; white-space: nowrap; }
  @media (max-width: 860px) {
    .head h2, .head p { grid-column: 1 / -1; }
    .tiles { grid-template-columns: 1fr; }
    .below { grid-template-columns: 1fr; gap: 10px; }
  }
</style>
