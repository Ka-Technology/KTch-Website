---
// What we do, D: the table's rows without the table: a photo, the name, the pitch, the example, with space between.
import { pillars, img } from '../../../data/site';
---
<section class="wrap section" aria-labelledby="wwd-d">
  <div class="head grid12" data-reveal>
    <h2 id="wwd-d" class="t-h2">What we do</h2>
    <p class="t-lead">Four kinds of work, one goal: fewer tedious hours. Open any one for the details.</p>
  </div>
  <div class="rows">
    {pillars.map((p) => (
      <article class="row grid12" data-reveal>
        <figure class="photo pic"><img src={img(p.image, 800)} width="800" height="800" alt={p.imageAlt} loading="lazy" /></figure>
        <h3><button type="button" data-open-dialog={`dlg-${p.slug}`} aria-haspopup="dialog">{p.name}<span aria-hidden="true"> +</span></button></h3>
        <p class="pitch">{p.pitch}</p>
        <p class="proof">{p.caseStudy && <a class="link" href={p.caseStudy.href}><span class="arrow">{p.caseStudy.label}</span></a>}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .head { margin-bottom: clamp(40px, 5vw, 72px); row-gap: 20px; }
  .head h2 { grid-column: 1 / 6; }
  .head p { grid-column: 7 / -1; max-width: 40ch; }
  .rows { display: grid; gap: clamp(28px, 3vw, 44px); }
  .row { align-items: center; }
  .pic { grid-column: 1 / 3; aspect-ratio: 1; }
  h3 { grid-column: 3 / 7; font-size: clamp(26px, 2.6vw, 44px); font-weight: 850; letter-spacing: -0.04em; line-height: 1.02; }
  h3 button {
    all: unset; cursor: pointer; text-decoration: underline; text-decoration-color: transparent;
    text-decoration-thickness: 3px; text-underline-offset: 6px; transition: text-decoration-color var(--t-hover) ease;
  }
  h3 button span { color: var(--accent-text); }
  h3 button:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
  @media (hover: hover) and (pointer: fine) { h3 button:hover { text-decoration-color: var(--accent); } }
  .pitch { grid-column: 7 / 11; font-size: var(--t-lead); line-height: 1.35; }
  .proof { grid-column: 11 / -1; justify-self: end; font-weight: 700; }
  @media (max-width: 860px) {
    .head h2, .head p { grid-column: 1 / -1; }
    .row { row-gap: 10px; align-items: start; }
    .pic { grid-column: 1 / 5; grid-row: 1 / 4; }
    h3, .pitch, .proof { grid-column: 5 / -1; justify-self: start; }
    h3 { font-size: clamp(22px, 6vw, 30px); }
    .pitch { font-size: var(--t-body); }
  }
</style>
