---
// Products option D, Picker: the four names sit side by side as a switch; the chosen one opens below
// with its picture, how it works and a link. Nobody is the headline; the visitor picks.
import { getCollection } from 'astro:content';
import { img } from '../../../data/site';
const products = (await getCollection('products', (p) => !p.data.hidden)).sort((a, b) => a.data.order - b.data.order);
---
<section class="pp inverse" aria-labelledby="pp-t" data-pp>
  <div class="wrap">
    <div class="grid12 top" data-reveal>
      <h2 id="pp-t" class="t-h2 heading">Our software</h2>
      <p class="t-lead intro">Besides client work, we build our own products. Some started as a client’s problem that turned out to be everyone’s problem.</p>
    </div>
    <div class="tabs" role="tablist" aria-label="Our products">
      {products.map((p, i) => (
        <button type="button" role="tab" id={`pp-tab-${p.id}`} aria-controls={`pp-panel-${p.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
          <span class="tn">{p.data.name}</span><span class="ts"><span class="dot"></span>{p.data.status}</span>
        </button>
      ))}
    </div>
    {products.map((p, i) => (
      <div class="panel" role="tabpanel" id={`pp-panel-${p.id}`} aria-labelledby={`pp-tab-${p.id}`} data-panel hidden={i !== 0}>
        {p.data.cover_image && <figure class="photo pic"><img src={img(p.data.cover_image, 1600)} width="1600" height="1100" alt={p.data.cover_alt} loading="lazy" /></figure>}
        <div class="info">
          <h3 class="t-h2">{p.data.tagline}</h3>
          <ol class="how">{p.data.how_it_works.map((s) => <li>{s}</li>)}</ol>
          <a class="button" href={`/products/${p.id}`}>More about {p.data.name}</a>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-pp]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const show = (i: number, focus = false) => {
      tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
      panels.forEach((p, j) => { p.hidden = i !== j; });
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); show((i + 1) % tabs.length, true); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); show((i - 1 + tabs.length) % tabs.length, true); }
      });
    });
  });
</script>

<style>
  .pp { padding-block: var(--section); }
  .heading { grid-column: 1 / 6; }
  .intro { grid-column: 7 / -1; max-width: 42ch; }
  .tabs { margin-top: clamp(48px, 6vw, 80px); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
  .tabs button {
    display: grid; gap: 8px; justify-items: start; text-align: left; padding: 18px 20px 20px; border: 0; cursor: pointer;
    background: var(--surface); color: var(--ink);
    transition: background-color var(--t-hover) ease, color var(--t-hover) ease, transform var(--t-press) var(--ease-out);
  }
  .tabs button:active { transform: scale(0.98); }
  .tn { font-size: clamp(24px, 2.4vw, 40px); font-weight: 850; letter-spacing: -0.045em; line-height: 1; }
  .ts { display: inline-flex; align-items: center; gap: 8px; font-size: var(--t-small); font-weight: 700; color: var(--muted); }
  .dot { width: 10px; height: 10px; background: var(--accent); border-radius: 50%; }
  .tabs button[aria-selected='true'] { background: var(--accent); color: var(--on-accent); }
  .tabs button[aria-selected='true'] .ts { color: var(--on-accent); }
  .tabs button[aria-selected='true'] .dot { background: var(--on-accent); }
  @media (hover: hover) and (pointer: fine) { .tabs button[aria-selected='false']:hover { background: var(--surface-2); } }
  .panel { margin-top: 6px; display: grid; grid-template-columns: 7fr 5fr; background: var(--surface); }
  .panel[hidden] { display: none; }
  .pic { aspect-ratio: 16 / 11; }
  .info { padding: clamp(24px, 3vw, 48px); display: grid; gap: 24px; align-content: center; justify-items: start; }
  .info h3 { font-size: clamp(28px, 2.8vw, 44px); }
  .how { list-style: none; counter-reset: s; display: grid; gap: 12px; }
  .how li { counter-increment: s; padding-left: 2em; position: relative; }
  .how li::before { content: counter(s); position: absolute; left: 0; top: 0; font-weight: 850; color: var(--accent-text); }
  @media (prefers-reduced-motion: no-preference) {
    .panel:not([hidden]) { animation: pp-in 500ms var(--ease-out); }
  }
  @keyframes pp-in { from { opacity: 0; transform: translateY(10px); } }
  @media (max-width: 860px) {
    .heading, .intro { grid-column: 1 / -1; }
    .intro { margin-top: 20px; }
    .tabs { grid-template-columns: 1fr 1fr; }
    .panel { grid-template-columns: 1fr; }
  }
</style>
