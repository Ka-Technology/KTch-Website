---
// What we do, C: four tall photo panels side by side; the one you point at or tap opens wide.
import { pillars, img } from '../../../data/site';
---
<section class="wrap section" aria-labelledby="wwd-c">
  <div class="head" data-reveal>
    <h2 id="wwd-c" class="t-h2">What we do</h2>
    <p class="t-lead">Four kinds of work, one goal: fewer tedious hours.</p>
  </div>
  <div class="panels" data-panels>
    {pillars.map((p, i) => (
      <article class={`panel ${i === 0 ? 'on' : ''}`} data-panel>
        <figure class="photo pic"><img src={img(p.image, 1600)} width="1600" height="2000" alt={p.imageAlt} loading="lazy" /></figure>
        <div class="card">
          <h3><button type="button" class="pick" data-pick aria-expanded={i === 0 ? 'true' : 'false'}>{p.name}</button></h3>
          <div class="more">
            <p>{p.pitch}</p>
            <div class="acts">
              <button type="button" class="link det" data-open-dialog={`dlg-${p.slug}`} aria-haspopup="dialog">What’s included +</button>
              {p.caseStudy && <a class="link" href={p.caseStudy.href}><span class="arrow">{p.caseStudy.label}</span></a>}
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-panels]').forEach((wrap) => {
    const panels = [...wrap.querySelectorAll<HTMLElement>('[data-panel]')];
    const open = (el: HTMLElement) => panels.forEach((p) => {
      const on = p === el; p.classList.toggle('on', on);
      p.querySelector('[data-pick]')?.setAttribute('aria-expanded', String(on));
    });
    panels.forEach((p) => {
      p.querySelector('[data-pick]')?.addEventListener('click', () => open(p));
      p.addEventListener('focusin', () => open(p));
      if (matchMedia('(hover: hover) and (pointer: fine)').matches) p.addEventListener('mouseenter', () => open(p));
    });
  });
</script>

<style>
  .head { display: grid; gap: 20px; margin-bottom: clamp(40px, 5vw, 72px); }
  .panels { display: flex; gap: 8px; height: min(78vh, 760px); min-height: 560px; }
  .panel { position: relative; flex: 1 1 0; min-width: 0; overflow: clip; transition: flex-grow 600ms var(--ease-out); }
  .panel.on { flex-grow: 3.2; }
  .pic { position: absolute; inset: 0; }
  .card { position: absolute; left: 0; right: 0; bottom: 0; background: var(--ink); color: var(--bg); padding: 20px 22px 22px; display: grid; gap: 14px; }
  h3 { font-size: clamp(20px, 1.7vw, 30px); font-weight: 850; letter-spacing: -0.035em; line-height: 1.05; }
  .pick { all: unset; cursor: pointer; }
  .pick:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
  .panel.on h3 { font-size: clamp(28px, 2.8vw, 48px); }
  .more { display: none; gap: 16px; max-width: 46ch; }
  .panel.on .more { display: grid; animation: up 500ms var(--ease-out) both; }
  .acts { display: flex; flex-wrap: wrap; gap: 20px; }
  .card .link { color: var(--bg); font-weight: 700; }
  .det { all: unset; cursor: pointer; font-weight: 700; color: var(--accent); }
  .det:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
  @keyframes up { from { opacity: 0; transform: translateY(10px); } }
  @media (prefers-reduced-motion: reduce) { .panel { transition: none; } .panel.on .more { animation: none; } }
  @media (max-width: 860px) {
    .panels { flex-direction: column; height: auto; min-height: 0; gap: 32px; }
    .panel { overflow: visible; }
    .pic { position: relative; aspect-ratio: 4 / 3; }
    .card { position: relative; }
    .panel h3 { font-size: clamp(26px, 7vw, 36px); }
    .more { display: grid; }
    .panel .more { animation: none; }
  }
</style>
