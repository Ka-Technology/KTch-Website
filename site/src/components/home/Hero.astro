---
import { img } from '../../data/site';
---
<section class="hero wrap" aria-labelledby="hero-title">
  <h1 id="hero-title" class="t-display lines title">
    <span class="line"><span data-line style="--i:0">Giving people the power</span></span>
    <span class="line"><span data-line style="--i:1">of meaningful choices.</span></span>
  </h1>

  <div class="body grid12">
    <div class="talk">
      <p class="t-lead" data-load style="--d:420ms">
        We’re a Portland team that builds AI tools, custom software and automations that take tedious
        work off your plate, so you can spend your time on the work that matters.
      </p>
      <div class="actions" data-load style="--d:500ms">
        <a class="button" href="/contact">Let’s talk</a>
        <a class="button button--quiet" href="/services#work">See our work</a>
      </div>
    </div>

    <div class="picture-col">
      <figure class="photo picture" data-open>
        <!-- Grey reel: bridges, landscapes, people laughing and walking. Decorative; muted. -->
        <video class="reel" data-reel autoplay muted loop playsinline preload="metadata"
          poster={img('hero-reel')} width="1280" height="720" aria-hidden="true">
          <source src="/video/hero-reel.mp4" type="video/mp4" />
        </video>
        <button class="reel-toggle" type="button" data-reel-toggle aria-label="Pause background video">
          <svg class="i-pause" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 2h3v10H3zM8 2h3v10H8z" fill="currentColor" /></svg>
          <svg class="i-play" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3.5 2v10l8-5z" fill="currentColor" /></svg>
        </button>
      </figure>
    </div>
  </div>
</section>

<script>
  // Motion is opt-out: reduced-motion visitors get the still poster; everyone gets a pause button.
  const video = document.querySelector<HTMLVideoElement>('[data-reel]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-reel-toggle]');
  if (video && toggle) {
    const sync = () => {
      toggle.dataset.paused = String(video.paused);
      toggle.setAttribute('aria-label', video.paused ? 'Play background video' : 'Pause background video');
    };
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { video.removeAttribute('autoplay'); video.pause(); }
    toggle.addEventListener('click', () => { video.paused ? video.play() : video.pause(); });
    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    sync();
  }
</script>

<style>
  .hero { padding-top: clamp(24px, 4vh, 56px); }
  .title { font-size: min(var(--t-display), calc((100vw - 2 * var(--margin)) / 11.9)); }
  .body { margin-top: clamp(48px, 9vh, 96px); align-items: start; }
  .talk { grid-column: 1 / 5; display: grid; gap: 32px; }
  .talk p { max-width: 26ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .picture-col { grid-column: 5 / -1; }
  /* the red band across the top of the picture */
  .picture {
    position: relative; aspect-ratio: 1600 / 1019; max-height: 66vh; width: 100%;
    background: #3a3a3c; border-top: clamp(10px, 1vw, 14px) solid var(--accent);
  }
  .reel { display: block; width: 100%; height: 100%; object-fit: cover; }
  .reel-toggle {
    position: absolute; right: 12px; bottom: 12px; width: 44px; height: 44px;
    display: grid; place-items: center; border: 0; cursor: pointer;
    background: rgb(11 11 12 / 0.55); color: #fafaf9;
    opacity: 0.7; transition: opacity var(--t-hover) ease, transform var(--t-press) var(--ease-out);
  }
  .reel-toggle:active { transform: scale(0.92); }
  .reel-toggle:focus-visible { opacity: 1; }
  @media (hover: hover) and (pointer: fine) { .reel-toggle:hover { opacity: 1; } }
  .i-play { display: none; }
  .reel-toggle[data-paused='true'] .i-play { display: block; }
  .reel-toggle[data-paused='true'] .i-pause { display: none; }

  @media (max-width: 860px) {
    .talk, .picture-col { grid-column: 1 / -1; }
    .talk .button { flex: 1 1 100%; }
    .picture-col { margin-top: 40px; margin-inline: calc(var(--margin) * -1); }
    .picture { aspect-ratio: 4 / 3; max-height: none; }
  }
</style>
