---
// The live thing: pick a chore, see it before and after. Every figure comes from a real project.
const chores = [
  {
    id: 'certs', tab: 'CE certificates', who: 'RealDoc, for Keller Williams Eugene-Springfield', href: '/products/realdoc',
    before: { big: '1 hour', note: 'Every week, a principal broker typed continuing-education certificates by hand.' },
    after: { big: '1 click', note: 'Every attendee’s certificate, generated, signed and zipped.' },
  },
  {
    id: 'reports', tab: 'Test reports', who: 'APEX Performance', href: '/work/apex-performance',
    before: { big: '5–6 min', note: 'Print the template, feed it back through, scan it, email it. Once or twice a day.' },
    after: { big: '1 step', note: 'Results land on the branded template as a ready-to-send PDF.' },
  },
  {
    id: 'hoa', tab: 'HOA reports', who: 'CIDA Analytics', href: '/work/cida-analytics',
    before: { big: '800 pages', note: 'HOA document dumps read by hand, sometimes 100+ files for one report.' },
    after: { big: '202 fields', note: 'Drafted by AI, then checked by staff next to the source page.' },
  },
];
const len = (s: string) => Math.max(s.length, 5);
---
<section class="swap wrap section" aria-labelledby="swap-title" data-swap>
  <div class="top grid12" data-reveal>
    <h2 id="swap-title" class="t-h2 heading">Before and after</h2>
    <div class="intro">
      <p class="t-lead">AI is a tool, not a replacement. We use it, plus good software, to take the tedious part off your plate.</p>
      <div class="tabs" role="tablist" aria-label="Pick a chore">
        {chores.map((c, i) => (
          <button type="button" role="tab" id={`tab-${c.id}`} aria-controls={`panel-${c.id}`}
            aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{c.tab}</button>
        ))}
      </div>
    </div>
  </div>

  {chores.map((c, i) => (
    <div class="panel" role="tabpanel" id={`panel-${c.id}`} aria-labelledby={`tab-${c.id}`} data-panel tabindex="0">
      <h3 class="sr-only">{c.tab}</h3>
      <div class="pair">
        <div class="spec spec--before">
          <p class="cap"><strong>Before.</strong> {c.before.note}</p>
          <p class="big" style={`--chars:${len(c.before.big)}`}>{c.before.big}</p>
        </div>
        <div class="spec spec--after">
          <p class="cap"><strong>After.</strong> {c.after.note}</p>
          <p class="big" style={`--chars:${len(c.after.big)}`}>{c.after.big}</p>
        </div>
      </div>
      <p class="who t-small"><a class="link" href={c.href}><span class="arrow">{c.who}</span></a></p>
    </div>
  ))}
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-swap]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    root.classList.add('is-live');
    const show = (i: number, focus = false) => {
      tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
      panels.forEach((p, j) => { p.hidden = i !== j; });
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(i));
      t.addEventListener('keydown', (e) => {
        const k = e.key;
        if (k === 'ArrowRight' || k === 'ArrowDown') { e.preventDefault(); show((i + 1) % tabs.length, true); }
        if (k === 'ArrowLeft' || k === 'ArrowUp') { e.preventDefault(); show((i - 1 + tabs.length) % tabs.length, true); }
        if (k === 'Home') { e.preventDefault(); show(0, true); }
        if (k === 'End') { e.preventDefault(); show(tabs.length - 1, true); }
      });
    });
    show(0);
  });
</script>

<style>
  .heading { grid-column: 1 / 6; }
  .intro { grid-column: 7 / -1; display: grid; gap: 28px; align-content: start; }
  .intro .t-lead { max-width: 40ch; }
  .tabs { display: none; flex-wrap: wrap; gap: 8px; }
  .is-live .tabs { display: flex; }
  .tabs button {
    min-height: 48px; padding: 0 20px; border: 0; cursor: pointer; font-weight: 700; font-size: var(--t-small);
    background: var(--surface-2); color: var(--ink);
    transition: background-color var(--t-hover) ease, color var(--t-hover) ease, transform var(--t-press) var(--ease-out);
  }
  .tabs button:active { transform: scale(0.96); }
  .tabs button[aria-selected='true'] { background: var(--ink); color: var(--bg); }
  @media (hover: hover) and (pointer: fine) { .tabs button[aria-selected='false']:hover { background: var(--ink); color: var(--bg); } }

  .panel { margin-top: clamp(56px, 9vh, 112px); }
  .panel:focus-visible { outline-offset: 8px; }
  .swap:not(.is-live) .panel + .panel { margin-top: 64px; }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gap); }
  .spec { background: var(--surface); padding: clamp(20px, 2.4vw, 36px); display: grid; gap: 24px; align-content: space-between; min-height: clamp(260px, 30vw, 420px); }
  .spec--after { background: var(--ink); color: var(--bg); }
  .spec--after .cap strong { color: var(--inv-accent-text); }
  .cap { font-size: var(--t-body); line-height: 1.45; max-width: 36ch; }
  .big {
    font-size: clamp(56px, calc(40vw / (var(--chars) * 0.56)), 220px);
    font-weight: 850; letter-spacing: -0.055em; line-height: 0.82; white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .who { margin-top: 20px; }
  @media (prefers-reduced-motion: no-preference) {
    .is-live .panel:not([hidden]) .big { animation: spec-in 700ms var(--ease-out) both; }
    .is-live .panel:not([hidden]) .spec--after .big { animation-delay: 90ms; }
  }
  @keyframes spec-in { from { opacity: 0; transform: translateY(0.18em); } to { opacity: 1; transform: none; } }
  @media (max-width: 860px) {
    .heading, .intro { grid-column: 1 / -1; }
    .intro { margin-top: 24px; }
    .pair { grid-template-columns: 1fr; }
    .spec { min-height: 0; }
    .big { font-size: clamp(48px, calc(84vw / (var(--chars) * 0.56)), 140px); }
  }
</style>
