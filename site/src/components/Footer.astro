---
import { site, nav, img } from '../data/site';
interface Props { strip?: boolean }
const { strip = true } = Astro.props;
const tiles = [
  { n: 'hawthorne-1912', alt: 'A 1912 postcard of the Hawthorne Bridge with its lift span raised.' },
  { n: 'st-johns-1938', alt: 'The St. Johns Bridge lit up at night, 1938.' },
  { n: 'union-station', alt: 'The clock tower of Portland’s Union Station.' },
  { n: 'downtown-portland', alt: 'Downtown Portland and the Willamette River today.' },
];
const year = new Date().getFullYear();
// "Ka" in thirteen scripts, as a rail that marks where the footer begins (shapes from the KTch Letters set)
const letters = [['english', 1.393], ['hindi', 1.346], ['kannada', 0.714], ['tamil', 1.449], ['telugu', 0.807], ['malayalam', 1.859], ['bengali', 1.412], ['gujarati', 0.829], ['punjabi', 1.085], ['odia', 0.98], ['urdu', 1.202], ['meitei', 1.174], ['ol-chiki', 1.458]] as const;
// every glyph gets about the same ink area, so wide and narrow scripts look the same size
const nudge: Record<string, number> = { english: 1.2, 'ol-chiki': 1.12 };  // lighter shapes read small at the same area
const sized = letters.map(([n, r]) => { const h = Math.min(1.2, Math.max(0.85, Math.sqrt(1.15 / r))) * (nudge[n] ?? 1); return { n, h: +h.toFixed(3), w: +(h * r).toFixed(3) }; });
const rail = Array.from({ length: 12 }, () => sized).flat();
const social = site.social.filter((s) => s.href);
---
<div class="rail" data-rail aria-hidden="true">
  {rail.map((g) => <span class="ka" style={`--m:url(/brand/letters/${g.n}.svg);--h:${g.h}em;--w:${g.w}em`}></span>)}
</div>
<script>
  // fit whole letters between the page margins: drop the ones that would be cut off, then spread the rest evenly
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  if (rail) {
    const kids = [...rail.children] as HTMLElement[];
    const fit = () => {
      rail.classList.remove('is-fit');
      kids.forEach((k) => (k.hidden = false));
      const cs = getComputedStyle(rail);
      const avail = rail.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
      const gap = parseFloat(cs.columnGap) || 0;
      let used = 0;
      kids.forEach((k) => { const w = k.getBoundingClientRect().width; if (used + w > avail + 0.5) k.hidden = true; else used += w + gap; });
      rail.classList.add('is-fit');
    };
    fit();
    new ResizeObserver(fit).observe(rail);
  }
</script>
{strip && (
  <div class="strip" data-reveal>
    {tiles.map((t) => <figure class="photo tile"><img src={img(t.n, 800)} width="800" height="500" alt={t.alt} loading="lazy" /></figure>)}
  </div>
)}
<footer class="site-footer">
  <div class="wrap">
    <div class="grid12 top">
      <div class="brand" data-reveal>
        <a href="/" class="logo-link" aria-label="Ka Technology, home">
          <img class="logo logo--red" src="/brand/ka-logo-complete.png" width="900" height="462" alt="Ka Technology" loading="lazy" />
          <img class="logo logo--white" src="/brand/ka-logo-complete-white.png" width="900" height="462" alt="Ka Technology" loading="lazy" />
        </a>
        <p class="slogan">{site.slogan}</p>
      </div>

      <nav class="col contact" aria-labelledby="f-contact" data-reveal>
        <h2 id="f-contact">Contact</h2>
        <ul>
          <li><a class="link" href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a class="link" href={site.phoneHref}>{site.phone}</a></li>
          <li>Based in {site.city}</li>
        </ul>
      </nav>

      <nav class="col explore" aria-labelledby="f-explore" data-reveal>
        <h2 id="f-explore">Explore</h2>
        <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
      </nav>

      <nav class="col more" aria-labelledby="f-more" data-reveal>
        <h2 id="f-more">More</h2>
        <ul>
          <li><a href="/contact">Let’s talk</a></li>
          <li><a href="/privacy">Privacy</a></li>
          <li><a href="/credits">Photo credits</a></li>
          {social.map((s) => <li><a href={s.href} rel="me noopener" target="_blank">{s.label}</a></li>)}
        </ul>
      </nav>
    </div>

    <div class="legal">
      <p>© {year} {site.legal}. All rights reserved.</p>
      <a href="#top">Back to top</a>
    </div>
  </div>
</footer>

<style>
  /* the rail: red on a light page, white on a dark one; as tall as the footer's body text */
  .rail { --rail: var(--accent); display: flex; align-items: center; gap: 0.8em; overflow: clip; white-space: nowrap; font-size: var(--t-body); padding: 0.9em var(--margin); height: 3.2em; }
  .rail.is-fit { justify-content: space-between; }
  .ka[hidden] { display: none; }
  .ka { flex: none; height: var(--h); width: var(--w); background: var(--rail); -webkit-mask: var(--m) center / contain no-repeat; mask: var(--m) center / contain no-repeat; }
  :global(:root[data-theme='dark']) .rail { --rail: var(--ink); }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme='light'])) .rail { --rail: var(--ink); } }
  .strip { display: grid; grid-template-columns: repeat(4, 1fr); }
  .tile { aspect-ratio: 16 / 10; margin: 0; }

  .site-footer { padding-block: clamp(36px, 4vw, 56px) 28px; font-size: var(--t-small); }
  .top { row-gap: 40px; align-items: start; }
  .brand { grid-column: 1 / 5; display: grid; gap: 16px; justify-items: start; }
  .logo-link { display: block; transition: transform var(--t-press) var(--ease-out); }
  .logo-link:active { transform: scale(0.98); }
  .logo { width: clamp(150px, 13vw, 190px); }
  .slogan { font-size: var(--t-body); font-weight: 600; max-width: 24ch; line-height: 1.4; }
  .logo--white { display: none; }
  /* the footer is in the page colour: red wordmark on a light page, white wordmark on a dark page */
  :global(:root[data-theme='dark']) .logo--red { display: none; }
  :global(:root[data-theme='dark']) .logo--white { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .logo--red { display: none; }
    :global(:root:not([data-theme='light'])) .logo--white { display: block; }
  }

  .col { display: grid; gap: 14px; align-content: start; }
  .contact { grid-column: 6 / 9; }
  .explore { grid-column: 9 / 11; }
  .more { grid-column: 11 / -1; }
  .col h2 { font-size: var(--t-small); font-weight: 700; letter-spacing: 0; color: var(--muted); }
  .col ul { list-style: none; display: grid; gap: 8px; }
  .col li { font-size: var(--t-body); }
  .col a:not(.link) {
    text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 2px; text-underline-offset: 5px;
    transition: text-decoration-color var(--t-hover) ease;
  }
  .contact .link { font-weight: 600; }
  @media (hover: hover) and (pointer: fine) {
    .col a:not(.link):hover, .legal a:hover { text-decoration-color: var(--accent); }
  }

  .legal { margin-top: clamp(48px, 5vw, 72px); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 24px; color: var(--muted); }
  .legal a { color: var(--ink); text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 4px; transition: text-decoration-color var(--t-hover) ease; }

  @media (max-width: 860px) {
    .tile { aspect-ratio: 1; }
    .brand { grid-column: 1 / -1; }
    .top { grid-template-columns: 1fr 1fr; column-gap: var(--gap); }
    .contact { grid-column: 1 / -1; }
    .explore { grid-column: 1; }
    .more { grid-column: 2; }
  }
</style>
