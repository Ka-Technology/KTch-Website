---
import { site, nav, img } from '../data/site';
import Logo from './Logo.astro';
interface Props { strip?: boolean }
const { strip = true } = Astro.props;
const tiles = [
  { n: 'hawthorne-1912', alt: 'A 1912 postcard of the Hawthorne Bridge with its lift span raised.' },
  { n: 'st-johns-1938', alt: 'The St. Johns Bridge lit up at night, 1938.' },
  { n: 'third-street-1910', alt: 'Third Street, downtown Portland, 1910.' },
  { n: 'downtown-portland', alt: 'Downtown Portland and the Willamette River today.' },
];
const year = new Date().getFullYear();
const social = site.social.filter((s) => s.href);
---
{strip && (
  <div class="strip" data-reveal>
    {tiles.map((t) => <figure class="photo tile"><img src={img(t.n, 800)} width="800" height="500" alt={t.alt} loading="lazy" /></figure>)}
  </div>
)}
<footer class="site-footer inverse">
  <div class="wrap">
    <div class="grid12 top">
      <div class="brand" data-reveal>
        <a href="/" class="logo-link" aria-label="Ka Technology, home">
          <Logo height={40} draw={false} class="logo" />
        </a>
        <p class="slogan">{site.slogan}</p>
      </div>

      <nav class="col contact" aria-labelledby="f-contact" data-reveal>
        <h2 id="f-contact">Contact</h2>
        <ul>
          <li><a class="link" href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a class="link" href={site.phoneHref}>{site.phone}</a></li>
          <li>Based in {site.city}</li>
        </ul>
      </nav>

      <nav class="col explore" aria-labelledby="f-explore" data-reveal>
        <h2 id="f-explore">Explore</h2>
        <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
      </nav>

      <nav class="col more" aria-labelledby="f-more" data-reveal>
        <h2 id="f-more">More</h2>
        <ul>
          <li><a href="/contact">Let’s talk</a></li>
          <li><a href="/privacy">Privacy</a></li>
          <li><a href="/credits">Photo credits</a></li>
          {social.map((s) => <li><a href={s.href} rel="me noopener" target="_blank">{s.label}</a></li>)}
        </ul>
      </nav>
    </div>

    <div class="legal">
      <p>© {year} {site.legal}. All rights reserved.</p>
      <a href="#top">Back to top</a>
    </div>
  </div>
</footer>

<style>
  .strip { display: grid; grid-template-columns: repeat(4, 1fr); }
  .tile { aspect-ratio: 16 / 10; margin: 0; }

  .site-footer { padding-block: clamp(56px, 6vw, 88px) 28px; font-size: var(--t-small); }
  .top { row-gap: 40px; align-items: start; }
  .brand { grid-column: 1 / 5; display: grid; gap: 16px; justify-items: start; }
  .logo-link { display: block; transition: transform var(--t-press) var(--ease-out); }
  .logo-link:active { transform: scale(0.98); }
  .logo-link { color: var(--accent); }
  .logo-link :global(.logo) { width: clamp(200px, 17vw, 250px); height: auto; }
  .slogan { font-size: var(--t-body); font-weight: 600; max-width: 24ch; line-height: 1.4; }

  .col { display: grid; gap: 14px; align-content: start; }
  .contact { grid-column: 6 / 9; }
  .explore { grid-column: 9 / 11; }
  .more { grid-column: 11 / -1; }
  .col h2 { font-size: var(--t-small); font-weight: 700; letter-spacing: 0; color: var(--muted); }
  .col ul { list-style: none; display: grid; gap: 8px; }
  .col li { font-size: var(--t-body); }
  .col a:not(.link) {
    text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 2px; text-underline-offset: 5px;
    transition: text-decoration-color var(--t-hover) ease;
  }
  .contact .link { font-weight: 600; }
  @media (hover: hover) and (pointer: fine) {
    .col a:not(.link):hover, .legal a:hover { text-decoration-color: var(--accent); }
  }

  .legal { margin-top: clamp(48px, 5vw, 72px); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 24px; color: var(--muted); }
  .legal a { color: var(--ink); text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 4px; transition: text-decoration-color var(--t-hover) ease; }

  @media (max-width: 860px) {
    .tile { aspect-ratio: 1; }
    .brand { grid-column: 1 / -1; }
    .top { grid-template-columns: 1fr 1fr; column-gap: var(--gap); }
    .contact { grid-column: 1 / -1; }
    .explore { grid-column: 1; }
    .more { grid-column: 2; }
  }
</style>
