---
import { getCollection } from 'astro:content';
import { serviceLabel, img } from '../data/site';
// `picks` lists entries in order as 'projects/<id>' or 'products/<id>'; without it, every project shows.
interface Props { heading?: string; headingTag?: 'h1' | 'h2'; filter?: boolean; limit?: number; id?: string; lede?: string; picks?: string[] }
const { heading = 'Our work', headingTag = 'h2', filter = false, limit, id = 'work-title', lede, picks } = Astro.props;
type Entry = { id: string; href: string; name: string; title: string; summary: string; meta: string; tags: string[]; image?: string; alt?: string; tagline?: string };
const yearOf = (y: string) => y.replace('–present', '–now');
const projectEntries: Entry[] = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order).map((p) => ({
  id: `projects/${p.id}`, href: `/work/${p.id}`, name: p.data.client, title: p.data.title, summary: p.data.summary,
  meta: `${p.data.services.map((s) => serviceLabel[s]).join(' · ')}, ${yearOf(p.data.year)}`, tags: p.data.services,
  image: p.data.cover_image, alt: p.data.cover_alt,
}));
const productEntries: Entry[] = (await getCollection('products', (p) => !p.data.hidden)).map((p) => ({
  id: `products/${p.id}`, href: `/products/${p.id}`, name: p.data.name, title: 'Our product', summary: p.data.summary,
  meta: `Product · ${p.data.status}, ${p.data.year}`, tags: ['product'], tagline: p.data.tagline,
  image: p.data.cover_image, alt: p.data.cover_alt,
}));
const byId = new Map([...projectEntries, ...productEntries].map((e) => [e.id, e]));
const all = picks ? picks.map((k) => byId.get(k)).filter((e): e is Entry => Boolean(e)) : projectEntries;
const projects = limit ? all.slice(0, limit) : all;
// only offer filters that match at least one project
const tags = ['ai', 'software', 'automation', 'web', 'analytics'].filter((t) => all.some((p) => p.tags.includes(t)));
const H = headingTag;
const seen = new Set<string>();
const firstUse = projects.map((p) => { if (!p.image) return true; const f = !seen.has(p.image); seen.add(p.image); return f; });
---
<section class="work wrap" aria-labelledby={id} data-work>
  <div class="top">
    <div class="ht">
      <H id={id} class={headingTag === 'h1' ? 't-display' : 't-h2'}>{heading}</H>
      {lede && <p class="t-lead lede">{lede}</p>}
    </div>
    {filter && (
      <div class="filters" role="group" aria-label="Filter by kind of work">
        <button type="button" aria-pressed="true" data-filter="all">All</button>
        {tags.map((t) => <button type="button" aria-pressed="false" data-filter={t}>{serviceLabel[t]}</button>)}
      </div>
    )}
  </div>
  <div class="layout">
    <ol class="names">
      {projects.map((p, i) => (
        <li data-item data-tags={p.tags.join(' ')} class={i === 0 ? 'is-active' : ''} data-i={i}>
          {p.image
            ? <figure class={`photo m-pic ${firstUse[i] ? '' : 'm-pic--dup'}`}><img src={img(p.image, 800)} width="800" height="500" alt={p.alt} loading="lazy" /></figure>
            : <div class="m-pic card" aria-hidden="true"><span class="card-name">{p.name}</span><span class="card-tag">{p.tagline}</span></div>}
          <a href={p.href} class="row">
            <span class="name">{p.name}</span>
            <span class="meta">{p.meta}</span>
          </a>
          <p class="drop"><strong>{p.title}.</strong> {p.summary} <span class="cap-meta">{p.meta}</span></p>
        </li>
      ))}
    </ol>
    <!-- one description panel in the space below the names: hovering a name swaps its text in place, so nothing moves.
         It repeats each item's own description (read with the link), so it's hidden from screen readers. -->
    <div class="desc" aria-hidden="true">
      {projects.map((p, i) => (
        <div class={`d ${i === 0 ? 'is-active' : ''}`} data-desc={i}>
          <p class="d-title">{p.title}</p>
          <p class="d-sum">{p.summary}</p>
          <p class="d-meta">{p.meta}</p>
        </div>
      ))}
    </div>
    <div class="preview" aria-hidden="true">
      <div class="frame">
        {projects.map((p, i) => (
          p.image
            ? <figure class={`photo pv ${i === 0 ? 'is-active' : ''}`} data-pv={i}><img src={img(p.image, 800)} width="800" height="1000" alt="" loading="lazy" /></figure>
            : <div class={`pv card ${i === 0 ? 'is-active' : ''}`} data-pv={i}><span class="card-name">{p.name}</span><span class="card-tag">{p.tagline}</span></div>
        ))}
      </div>
    </div>
  </div>
  <slot />
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-work]').forEach((root) => {
    const items = [...root.querySelectorAll<HTMLElement>('[data-item]')];
    const pvs = [...root.querySelectorAll<HTMLElement>('[data-pv], [data-desc]')];
    // the photo and the description below the names follow the last name pointed at or focused
    const set = (i: number) => {
      items.forEach((el) => el.classList.toggle('is-active', Number(el.dataset.i) === i));
      pvs.forEach((el) => el.classList.toggle('is-active', Number(el.dataset.pv ?? el.dataset.desc) === i));
    };
    items.forEach((el) => {
      const i = Number(el.dataset.i);
      const head = el.querySelector<HTMLElement>('a.row');
      head?.addEventListener('pointerenter', () => set(i));
      head?.addEventListener('focus', () => set(i));
    });
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    buttons.forEach((b) => b.addEventListener('click', () => {
      const f = b.dataset.filter!;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      let first = -1;
      items.forEach((el) => {
        const show = f === 'all' || (el.dataset.tags || '').split(' ').includes(f);
        el.hidden = !show;
        if (show && first < 0) first = Number(el.dataset.i);
      });
      if (first >= 0) set(first);
    }));
  });
</script>

<style>
  .work { padding-bottom: clamp(88px, 10vw, 160px); }
  .top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 48px; }
  .ht { display: grid; gap: 20px; }
  .lede { max-width: 44ch; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .filters button { min-height: 44px; padding: 0 18px; border: 0; background: var(--surface-2); font-weight: 700; font-size: var(--t-small); cursor: pointer; transition: background-color var(--t-hover) ease, color var(--t-hover) ease, transform var(--t-press) var(--ease-out); }
  .filters button:active { transform: scale(0.96); }
  .filters button[aria-pressed='true'] { background: var(--ink); color: var(--bg); }
  .layout { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); }
  .names { grid-column: 1 / 9; list-style: none; }
  .row { display: flex; align-items: baseline; gap: 20px; padding: 10px 0; text-decoration: none; color: var(--muted); transition: color var(--t-hover) ease; }
  .name { font-size: var(--t-h2); font-weight: 800; letter-spacing: -0.045em; line-height: 1; }
  .meta { display: none; font-size: var(--t-small); font-weight: 600; }
  .is-active .row, .row:focus-visible { color: var(--ink); }
  .is-active .name { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 0.06em; text-underline-offset: 0.12em; }
  .names .m-pic { display: none; }
  .preview { grid-column: 9 / -1; grid-row: 1 / span 2; position: sticky; top: 12vh; align-self: start; }
  .frame { position: relative; aspect-ratio: 4 / 5; background: var(--surface-2); overflow: clip; }
  .pv { position: absolute; inset: 0; opacity: 0; visibility: hidden; transition: opacity 220ms ease, visibility 0s linear 220ms; }
  .pv.is-active { opacity: 1; visibility: visible; transition: opacity 220ms ease; }
  .pv img { transform: scale(1.04); transition: transform 900ms var(--ease-out); }
  .pv.is-active img { transform: none; }
  /* each name's own description is read with it, but shown only on phones; on desktop the panel below shows it */
  .drop { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .names { grid-row: 1; }
  .desc { grid-column: 1 / 8; grid-row: 2; align-self: end; display: grid; margin-top: clamp(40px, 5vw, 64px); }
  .d { grid-area: 1 / 1; display: grid; gap: 10px; align-content: start; opacity: 0; visibility: hidden; transition: opacity 200ms ease, visibility 0s linear 200ms; }
  .d.is-active { opacity: 1; visibility: visible; transition: opacity 200ms ease 60ms; }
  .d-title { font-size: clamp(22px, 1.9vw, 30px); font-weight: 800; letter-spacing: -0.02em; line-height: 1.2; }
  .d-sum { max-width: 44ch; font-size: var(--t-lead); line-height: 1.4; }
  .d-meta { font-size: var(--t-small); font-weight: 600; color: var(--muted); }
  @media (prefers-reduced-motion: reduce) { .d, .d.is-active { transition: none; } }
  /* products have no photograph: a type panel in Ka red stands in */
  .card { background: var(--accent); color: var(--on-accent); display: grid; align-content: space-between; padding: clamp(20px, 2.4vw, 32px); }
  .card-name { font-size: clamp(40px, 4.4vw, 72px); font-weight: 850; letter-spacing: -0.05em; line-height: 0.95; overflow-wrap: anywhere; }
  .card-tag { font-size: var(--t-lead); font-weight: 700; letter-spacing: -0.015em; line-height: 1.25; max-width: 18ch; }
  .cap-meta { display: block; margin-top: 6px; color: var(--muted); font-weight: 600; }
  @media (max-width: 860px) {
    .names { grid-column: 1 / -1; display: grid; gap: 40px; }
    .preview { display: none; }
    .names .m-pic { display: block; aspect-ratio: 16 / 10; }
    .names .m-pic.card { display: grid; }
    .names .card-name { display: none; }  /* the name sits right below on phones */
    .names .m-pic--dup { display: none; }
    .names { gap: 28px; }
    .meta { display: none; }
    .desc { display: none; }
    .drop { position: static; width: auto; height: auto; overflow: visible; clip-path: none; white-space: normal; padding-top: 8px; max-width: 52ch; line-height: 1.45; }
    .row { flex-direction: column; gap: 6px; color: var(--ink); padding-top: 14px; }
    .name { font-size: clamp(32px, 9.5vw, 48px); }
    .is-active .name { text-decoration: none; }
  }
</style>
