---
// Ka Technology 3.0 symbol alone, drawn as a stroke so it takes currentColor.
// Both traces start at the tips of the plus, so the plus forms first.
interface Props { size?: number; class?: string; title?: string }
const { size = 36, class: cls = '', title } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 115 115" fill="none" stroke="currentColor"
  stroke-width="5.74" stroke-linecap="round" stroke-linejoin="round" role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'} aria-label={title}>
  <path class="ka-draw ka-trace-a" pathLength="1" d="M3.6 99.55H110.6V4.05H15.16V55.3" />
  <path class="ka-draw ka-trace-b" pathLength="1" d="M15.16 111.6V75.68H39.17V28.64H86.9V75.68H60.32" />
</svg>
