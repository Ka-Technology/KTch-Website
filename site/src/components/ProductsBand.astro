---
import { getCollection } from 'astro:content';
const products = (await getCollection('products', (p) => !p.data.hidden)).sort((a, b) => a.data.order - b.data.order);
const [lead, ...rest] = products;
---
<section class="products inverse" aria-labelledby="products-title">
  <div class="wrap grid12 inner">
    <div class="intro" data-reveal>
      <h2 id="products-title" class="t-h2">Our software</h2>
      <p class="t-lead">Besides client work, we build our own products. Some started as a client’s problem that turned out to be everyone’s problem.</p>
    </div>
    {lead && (
      <article class="lead" data-reveal>
        <h3 class="pname"><a href={`/products/${lead.id}`}>{lead.data.name}</a></h3>
        <p class="t-lead tag">{lead.data.tagline} <span class="status"><span class="dot"></span>{lead.data.status}</span></p>
        <ul class="how">{lead.data.how_it_works.map((s) => <li>{s}</li>)}</ul>
        <a class="link" href={`/products/${lead.id}`}><span class="arrow">More about {lead.data.name}</span></a>
      </article>
    )}
    <div class="rest">
      {rest.map((p) => (
        <article class="small" data-reveal>
          <h3 class="pname pname--s"><a href={`/products/${p.id}`}>{p.data.name}</a></h3>
          <p class="tag2">{p.data.tagline} <span class="status"><span class="dot"></span>{p.data.status}</span></p>
          <p class="sum">{p.data.summary}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .products { padding-block: var(--section); }
  .inner { row-gap: 64px; }
  .intro { grid-column: 1 / 6; display: grid; gap: 20px; align-content: start; }
  .lead { grid-column: 7 / -1; display: grid; gap: 22px; align-content: start; }
  .rest { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gap); }
  .small { background: var(--surface); padding: clamp(24px, 3vw, 44px); display: grid; gap: 14px; align-content: start; transition: background-color var(--t-hover) ease; }
  @media (hover: hover) and (pointer: fine) { .small:hover { background: var(--surface-2); } }
  .status { display: inline-flex; align-items: center; gap: 8px; margin-left: 10px; padding: 2px 10px; background: var(--surface-2); font-size: var(--t-small); font-weight: 700; letter-spacing: 0; vertical-align: 0.15em; white-space: nowrap; }
  .small .status { background: var(--bg); }
  .dot { width: 10px; height: 10px; background: var(--accent); border-radius: 50%; }
  .pname { font-size: var(--t-display); letter-spacing: -0.05em; }
  .pname--s { font-size: var(--t-h2); }
  .pname a { text-decoration: none; transition: color var(--t-hover) ease; }
  @media (hover: hover) and (pointer: fine) { .pname a:hover { color: var(--accent); } }
  .pname a::after { content: ""; position: absolute; inset: 0; }
  .small { position: relative; }
  .tag { font-weight: 600; }
  .tag2 { font-size: var(--t-lead); font-weight: 700; letter-spacing: -0.01em; }
  .sum { font-size: var(--t-body); max-width: 46ch; }
  .how { list-style: none; display: grid; gap: 12px; font-size: var(--t-body); max-width: 52ch; counter-reset: s; }
  .how li { padding-left: 1.3em; position: relative; }
  .how li::before { content: ""; position: absolute; left: 0; top: 0.6em; width: 0.45em; height: 0.45em; background: var(--accent); }
  @media (max-width: 860px) {
    .intro, .lead { grid-column: 1 / -1; }
    .rest { grid-template-columns: 1fr; }
  }
</style>
