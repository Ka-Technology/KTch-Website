---
interface Props { title?: [string, string]; text?: string }
const { title = ['Got a tedious process?', 'Let’s make it disappear.'], text = 'Tell us what’s slowing you down. We’ll get back to you within 1–2 business days.' } = Astro.props;
const len = Math.max(...title.map((t) => t.length));
---
<section class="close" aria-labelledby="close-title">
  <div class="wrap inner">
    <h2 id="close-title" class="t-display lines fit" style={`--len:${len}`} data-reveal>
      <span class="line"><span>{title[0]}</span></span>
      <span class="line"><span>{title[1]}</span></span>
    </h2>
    <div class="foot" data-reveal>
      <p class="t-lead">{text} <a class="link go" href="/contact"><span class="arrow">Let’s talk</span></a></p>
    </div>
  </div>
</section>

<style>
  .close { display: flex; }
  .inner { display: flex; flex-direction: column; justify-content: space-between; gap: clamp(32px, 4vw, 56px); padding-block: clamp(80px, 9vw, 140px) clamp(80px, 8vw, 128px); width: 100%; }
  .fit { font-size: min(var(--t-display), calc((100vw - 2 * var(--margin)) / (var(--len) * 0.54))); }
  /* one sentence and its link, kept to two lines */
  .foot p { max-width: 58ch; color: var(--ink); font-weight: 600; text-wrap: balance; }
  .go { white-space: nowrap; font-weight: 750; }
  /* phones: the sentence alone takes the width, so the link moves underneath as its own tap target */
  @media (max-width: 600px) { .go { display: flex; width: fit-content; align-items: center; min-height: 44px; margin-top: 10px; } }
</style>
