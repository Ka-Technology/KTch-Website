---
// "Many into one": scattered squares are pulled into a ribbon, then released as ordered rows.
let seed = 20240501;
const rnd = () => ((seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296);
type Sq = { x: number; y: number; c: string; d: number };
const S = 12;
const sq: Sq[] = [];
for (let i = 0; i < 48; i++) sq.push({ x: 10 + rnd() * 340, y: 10 + rnd() * 250, c: rnd() > 0.5 ? 'a' : 'b', d: rnd() * 0.3 });
for (let col = 0; col < 24; col++) for (let r = 0; r < 3; r++) sq.push({ x: 400 + col * 16.5, y: 111 + r * 16, c: col < 8 ? 'b' : col < 16 ? 'm' : 'r', d: 0.3 + col / 60 });
for (let r = 0; r < 5; r++) for (let col = 0; col < 8; col++) sq.push({ x: 838 + col * 44, y: 32 + r * 50, c: 'r', d: 0.75 + (col + r) / 40 });
const steps = [
  { name: 'Listen.', text: 'We start with your problem, not our favorite tech.' },
  { name: 'Build.', text: 'Small team, fast iterations, regular demos.' },
  { name: 'Stick around.', text: 'We maintain and improve what we ship.' },
];
---
<section class="how wrap section" aria-labelledby="how-title">
  <div class="grid12 top" data-reveal>
    <h2 id="how-title" class="t-h2 heading">How we work</h2>
    <p class="t-lead para">Your messy, scattered process goes in. One clear tool comes out, and we keep it running.</p>
  </div>
  <div class="diagram" data-squares>
    <svg class="h" viewBox="0 0 1200 280" role="img" aria-label="Scattered squares on the left are pulled into a tight ribbon in the middle and come out as neat red rows on the right.">
      {sq.map((s) => <rect x={s.x.toFixed(1)} y={s.y.toFixed(1)} width={S} height={S} class={`c-${s.c}`} style={`--d:${s.d.toFixed(2)}s`} />)}
    </svg>
    <svg class="v" viewBox="0 0 280 1200" role="img" aria-label="Scattered squares at the top are pulled into a tight band and come out as neat red rows at the bottom.">
      {sq.map((s) => <rect x={s.y.toFixed(1)} y={s.x.toFixed(1)} width={S} height={S} class={`c-${s.c}`} style={`--d:${s.d.toFixed(2)}s`} />)}
    </svg>
    <ol class="steps">
      {steps.map((s) => <li><strong>{s.name}</strong><span>{s.text}</span></li>)}
    </ol>
  </div>
</section>

<script>
  const els = document.querySelectorAll('[data-squares]');
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { threshold: 0.25 });
  els.forEach((el) => io.observe(el));
</script>

<style>
  .heading { grid-column: 1 / 5; }
  .para { grid-column: 6 / 11; max-width: 40ch; align-self: end; }
  .diagram { margin-top: 64px; display: grid; }
  svg { width: 100%; height: auto; }
  .v { display: none; }
  .c-a { fill: var(--sq-a); } .c-b { fill: var(--sq-b); } .c-m { fill: var(--muted); } .c-r { fill: var(--accent); }
  .steps { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap); margin-top: 40px; }
  .steps li { display: grid; gap: 8px; font-size: var(--t-body); max-width: 30ch; }
  .steps strong { font-size: var(--t-lead); letter-spacing: -0.02em; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) [data-squares] rect { opacity: 0; transform: translateY(14px); transform-box: fill-box; transition: opacity 500ms var(--ease-out), transform 700ms var(--ease-out); transition-delay: var(--d); }
    :global(.js) [data-squares].is-in rect { opacity: 1; transform: none; }
  }
  @media (max-width: 860px) {
    .heading, .para { grid-column: 1 / -1; }
    .para { margin-top: 20px; }
    .diagram { grid-template-columns: minmax(0, 150px) 1fr; gap: 28px; }
    .h { display: none; }
    .v { display: block; }
    .steps { grid-template-columns: 1fr; grid-template-rows: repeat(3, 1fr); margin-top: 0; }
    .steps li { align-content: center; }
    
  }
</style>
